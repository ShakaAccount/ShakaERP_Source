"            <t t-if=\"customer\">\n"
"                <t t-out=\"customer.name or ''\"/> قرار ملاقاتی با عنوان <strong t-out=\"object.event_id.appointment_type_id.name or ''\">Schedule a Demo</strong> با شما ثبت کرده است.\n"
"                <t t-if=\"object.event_id.appointment_type_id and object.event_id.appointment_status == 'request'\">\n"

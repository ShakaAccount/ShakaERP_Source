"                                    نظر شما درباره خدمات ما چیست؟\n"
"                                </h2>\n"
"                                <div style=\"text-color:#888888;\">(روی یکی از شکلک‌ها کلیک کنید)</div>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding:10px 10px;\">\n"
"                                <table style=\"width:100%;text-align:center;\">\n"
"                                    <tr>\n"
"                                        <td>\n"
"                                            <a t-attf-href=\"/rate/{{ access_token }}/5\\">\n"
"                                                <img alt=\"راضی\" src=\"/rating/static/src/img/rating_5.png\" title=\"راضی\"/>\n"
"                                            </a>\n"
"                                        </td>\n"
"                                        <td>\n"
"                                            <a t-attf-href=\"/rate/{{ access_token }}/3\\">\n"
"                                                <img alt=\"قابل قبول\" src=\"/rating/static/src/img/rating_3.png\" title=\"قابل قبول\"/>\n"
"                                            </a>\n"
"                                        </td>\n"
"                                        <td>\n"
"                                            <a t-attf-href=\"/rate/{{ access_token }}/1\\">\n"
"                                                <img alt=\"ناراضی\" src=\"/rating/static/src/img/rating_1.png\" title=\"ناراضی\"/>\n"
"                                            </a>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                </td>\n"
"            </tr>\n"
"\n"
"            <tr data-o-mail-quote-container=\"1\">\n"
"                <td style=\"padding:15px 20px 10px 20px;\" t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">\n"
"                    --<br data-o-mail-quote=\"1\"/>مدیر سیستم\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"\n"
"    <table style=\"width:600px;margin:auto;text-align:center;font-size:12px;direction:rtl;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td style=\"padding-top:10px;color:#afafaf;\">\n"
"                    <p>\n"
"                        این ایمیل به‌صورت خودکار توسط\n"
"                        <a target=\"_blank\" href=\"https://www.odoo.com/app/subscriptions\"\n"
"                           t-attf-style=\"color: {{object.company_id.email_secondary_color or '#875A7B'}}; text-decoration:none;\">\n"
"                            اشتراک اودو\n"
"                        </a>\n"
"                        برای\n"
"                        <a t-att-href=\"object.company_id.website\"\n"
"                           t-attf-style=\"color: {{object.company_id.email_secondary_color or '#875A7B'}}; text-decoration:none;\"\n"
"                           t-out=\"object.company_id.name or ''\">\n"
"                            شرکت شما\n"
"                        </a>\n"
"                        ارسال شده است.\n"
"                    </p>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"</div>\n"
" "


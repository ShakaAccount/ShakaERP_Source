#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Ask the developer to go through this checklist before asking for a review.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">قبل از درخواست بازبینی، از یک توسعه‌دهنده بخواهید این چک لیست را بررسی کند.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain in a few words the problem that this change is going to solve.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">با چند کلمه مسئله‌ای که این تغییر قرار است حل کند را شرح دهید.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain in a single sentence what has been changed.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در یک جمله توضیح دهید که چه چیزی تغییر یافته است.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain the consequences of this issue.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">پیامدی که این مشکل دارد را توضیح دهید.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain what went wrong in just a few words.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">با چند کلمه مشکلی که پیش آمده است را شرح دهید.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">How did it get to happen?</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">چطور این اتفاق افتاد؟</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">How was it solved?</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">چگونه حل شد؟</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Lay here any remaining question or doubt.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">هر سؤال یا تردید دیگری که وجود دارد را اینجا وارد کنید.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
#. module: knowledge
msgid ""
"<em>\n"
"                    <font class=\"text-600\">List here all the changes to implement.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در این قسمت تمام تغییرات نیازمند پیاده‌سازی را وارد کنید.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification

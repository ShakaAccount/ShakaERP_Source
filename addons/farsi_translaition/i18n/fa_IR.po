#: model_terms:ir.ui.view,arch_db:l10n_ir_hr.report_contract_document
#. module: l10n_ir_hr
msgid ""
"4-1- محل انجام کار و یا هر کدام از کارگاه های شرکت که توسط کارفرما تعیین و به کارگر ابلاغ شود.\n"
"                    <br/>\n"
"                    4-2- در صورتیکه کارگر انجام کار در محل تعیین شده را نپذیرد، این قراداد با نظر کارفرما فسخ شده تلقی\n"
"                    می گردد و برای مدت باقیمانده قابل اجرا نمی باشد."
msgstr ""

#: model_terms:ir.ui.view,arch_db:l10n_ir_hr.report_contract_document
#. module: l10n_ir_hr
msgid ""
"5-1- حضور در محل کار در ساعات کار مقرر از طرف کارفرما.\n"
"                    <br/>\n"
"                    5-2- انجام بموقع وظایف محوله در چارچوب دستورات و آیین نامه های موجود در ساعات اداری.\n"
"                    <br/>\n"
"                    5-3- رعایت کلیه ضوابط و اصول ایمنی مرتبط با کار محوله\n"
"                    <br/>\n"
"                    5-4- رعایت اصول امانت داری، محرمانه شمردن و عدم انتقال، افشای عمدی، سهوی و یا استفاده انتقالی از\n"
"                    کلیه آمار و اطلاعات کتبی و شفاهی که در جریان کار به دست می آورد و با فعالیت های کارفرما و"
msgstr ""

#: model_terms:ir.ui.view,arch_db:l10n_ir_hr.report_contract_document
#. module: l10n_ir_hr
msgid ""
"6-1- تامین ابزار و محل مناسبی جهت فعالیت کارپذیر.\n"
"                    <br/>\n"
"                    6-2- تامین ایاب و ذهاب کارپذیر به به محل پروژه ها یا ماموریتهای احتمالی.\n"
"                    <br/>\n"
"                    6-3- تامین امکانات مورد نیاز معمول برای ماموریتهای احتمالی طبق روش اجرایی ماموریت کارفرما.\n"
"                    <br/>\n"
"                    6-4- پرداخت حقوق و مزایا مطابق با ماده سه (3) این قراداد"
msgstr ""

#: model_terms:ir.ui.view,arch_db:l10n_ir_hr.report_contract_document
#. module: l10n_ir_hr
msgid ""
"9-1- کلیه اسناد، نقشه ها، طرحها، اطلاعات، ابداعات و اختراعات مربوط به موضوع این قرارداد که به موجب\n"
"                    این قراداد توسط کارگر تهیه می شوند، متعلق به کارفرما می باشد و کارفرما میتواند به طور مستقیم و یا\n"
"                    غیر مستقیم از آنها در اجرای طرحهای مختلف استفاده نماید.\n"
"                    <br/>\n"
"                    9-2- کارگر به هیچ وجه مجاز به استفاده از اسناد، نقشه ها، طرحها، اطلاعات مربوط به موضوع این قراداد،\n"
"                    بدون اخذ موافقت کتبی از کارفرما در پروژه های دیگر نمی باشد و در صورت کشف تخلف از این بند پیگیری\n"
"                    قانون لازم انجام خواهد شد."
msgstr ""


"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"\n"
"    <table style=\"width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;direction:rtl;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td style=\"padding:15px 20px 10px 20px;\">\n"
"                    <p>سلام،</p>\n"
"                    <p>\n"

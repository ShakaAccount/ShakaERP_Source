"            <t t-out=\"object.common_name or ''\">Wood Corner</t> گرامی،\n"
"        </span>\n"
"\n"
"        <t t-if=\"target_customer\">\n"
"            <t t-if=\"not object.event_id.appointment_type_id.is_always_confirm\">\n"
"                <t t-if=\"object.event_id.appointment_status == 'booked'\">\n"
"                    احتراماً به اطلاع می‌رساند که قرار ملاقات شما با عنوان <strong t-out=\"object.event_id.appointment_type_id.name or ''\">Schedule a Demo</strong><t t-if=\"object.event_id.appointment_type_id.category not in ['custom', 'anytime'] and object.event_id.appointment_type_id.schedule_based_on == 'users'\"> با <t t-out=\"object.event_id.user_id.name or ''\">Ready Mat</t></t> تأیید شده است.<br/>\n"
"                </t>\n"
"                <t t-elif=\"object.event_id.appointment_status == 'request'\">\n"
"                    درخواست رزرو شما برای <strong t-out=\"object.event_id.appointment_type_id.name or ''\">Schedule a Demo</strong><t t-if=\"object.event_id.appointment_type_id.category not in ['custom', 'anytime'] and object.event_id.appointment_type_id.schedule_based_on == 'users'\"> با <t t-out=\"object.event_id.user_id.name or ''\">Ready Mat</t></t> دریافت شد.<br/>\n"
"                    پس از تأیید، به شما اطلاع‌رسانی خواهد شد.\n"
"                </t>\n"
"            </t>\n"
"            <t t-else=\"\">\n"
"                قرار ملاقات شما با عنوان <strong t-out=\"object.event_id.appointment_type_id.name or ''\">Schedule a Demo</strong> <t t-if=\"object.event_id.appointment_type_id.category not in ['custom', 'anytime'] and object.event_id.appointment_type_id.schedule_based_on == 'users'\"> با <t t-out=\"object.event_id.user_id.name or ''\">Ready Mat</t></t> رزرو شد.\n"
"            </t>\n"
"        </t>\n"

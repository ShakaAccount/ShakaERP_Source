#: model_terms:ir.ui.view,arch_db:l10n_ir_hr.report_contract_document
#. module: l10n_ir_hr
msgid ""
"ارتباط دارد، بدون مجوز کتبی کارفرما.\n"
"                    <br/>\n"
"                    5-5- حفظ منافع، اعتبار و نام تجاری شرکت در انجام امور محوله.\n"
"                    <br/>\n"
"                    5-6- رعایت انضباط، مقررات اداری، حفظ شئونات اسلامی و اخلاقی در رفتار و برخورد شایسته با همکاران و\n"
"                    ارباب رجوع.\n"
"                    <br/>\n"
"                    5-7- تبعیت از دستورات مافوق خود.\n"
"                    <br/>\n"
"                    5-8- رعایت کلیه دستورالعمل ها، گردشکار ها و رویه های مصوب شرکت.\n"
"                    <br/>\n"
"                    5-9- در صورتیکه کارگر بخواهد قرارداد کاری خود را با شرکت قطع نماید می بایست حداقل یک ماه قبل به صورت\n"
"                    کتبی به کارفرما اعلام و با نظر کارفرما نسبت به تحویل اطلاعات، اسناد و اموال اقدام نماید در غیر\n"
"                    اینصورت ترک کار تلقی شده و مشمول دریافت مزایای پایان کار نخواهد شد.\n"
"                    <br/>\n"
"                    5-10- در صورت عدم رعایت مفاد فوق، مطابق ضوابط و مقررات شرکت با کارگر عمل شده و در صورت نیاز با وی\n"
"                    برخورد قانونی خواهد شد."
msgstr ""

#: model_terms:ir.ui.view,arch_db:l10n_ir_hr.report_contract_document
#. module: l10n_ir_hr

"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در این قسمت تمام محتوا و اسناد مربوط به وظیفه را لیست کنید.</font>\n"
"                </em>"

#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_personal_organizer
#. module: knowledge

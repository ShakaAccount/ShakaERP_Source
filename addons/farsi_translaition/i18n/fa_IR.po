#: code:addons/mail/models/mail_gateway_allowed.py:0
#. module: mail
msgid ""
"\n"
"            <p class=\"o_view_nocontent_smiling_face\">\n"
"                Add addresses to the Allowed List\n"
"            </p><p>\n"
"                To protect you from spam and reply loops, Odoo automatically blocks emails\n"
"                coming to your gateway past a threshold of <b>%(threshold)i</b> emails every <b>%(minutes)i</b>\n"
"                minutes. If there are some addresses from which you need to receive very frequent\n"
"                updates, you can however add them below and Odoo will let them go through.\n"
"            </p>"
msgstr ""
"\n"
"            <p class=\"o_view_nocontent_smiling_face\">\n"
"                افزودن آدرس‌ها به لیست مجاز\n"
"            </p><p>\n"
"                برای محافظت از شما در برابر اسپم و حلقه‌های پاسخ، اودوو به‌طور خودکار ایمیل‌های ورودی به دروازه‌تان \n"
"                را پس از رسیدن به آستانه‌ی <b>%(threshold)i</b> ایمیل در هر <b>%(minutes)i</b> دقیقه مسدود می‌کند.\n"
"                با این حال، اگر آدرس‌هایی وجود دارند که نیاز دارید به‌طور مرتب به‌روزرسانی‌های بسیار زیادی از آنها دریافت کنید،\n"
"                می‌توانید آنها را در این لیست اضافه کنید تا اودوو به آنها اجازه عبور بدهد.\n"
"            </p>"


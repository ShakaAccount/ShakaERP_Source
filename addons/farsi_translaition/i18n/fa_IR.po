#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"&amp;#128075; <br/>\n"
"    Welcome to the To-do app!"
msgstr ""
"&amp;#128075; <br/>\n"
"    به ماژول لیست کار خوش آمدید!"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<br/>\n"
"    <span style=\"font-size: 14px;\">\n"
"        Ensure you follow the correct format and order. For example: Send invitations #event @Mitchell !\n"
"    </span>"
msgstr ""
"<br/>\n"
"    <span style=\"font-size: 14px;\">\n"
"        اطمینان حاصل کنید که فرمت و ترتیب صحیحی را دنبال می‌کنید. برای مثال: ارسال دعوت‌نامه‌ها #رویداد @علیرضا !\n"
"    </span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"            Below this list, try\n"
"            <span style=\"font-weight: bolder;\">commands</span>\n"
"            by\n"
"            <span style=\"font-weight: bolder;\">\n"
"                <font style=\"color: #017E84\">typing</font>\n"
"            </span>\n"
"            \"<span style=\"font-weight: bolder;\">/</span>\"\n"
"        </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"            در ادامه این لیست از\n"
"            <span style=\"font-weight: bolder;\">دستورات استفاده کنید.</span>\n"
"            برای این کار\n"
"            \"<span style=\"font-weight: bolder;\">/</span>\"\n"
"        را تایپ کنید.</span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"            Select text to\n"
"            <font style=\"background-color: #017E84; color: white\">Highlight</font>,\n"
"            <span style=\"text-decoration-line: line-through;\">strikethrough</span>\n"
"            or\n"
"            <span style=\"font-weight: bolder;\">style</span>\n"
"            <span style=\"font-style: italic; text-decoration-line: underline;\">it</span>\n"
"        </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"            متن انتخابی را to\n"
"            <font style=\"background-color: #017E84; color: white\">هایلایت</font>,\n"
"            <span style=\"text-decoration-line: line-through;\">خط‌دار کنید</span>\n"
"            یا\n"
"            <span style=\"font-weight: bolder;\">استایل</span>\n"
"            <span style=\"font-style: italic; text-decoration-line: underline;\">دهید</span>\n"
"        </span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Access your personal pipeline with your to-dos and assigned tasks by going to the Project app and clicking\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">My Tasks</font>.\n"
"        </span>\n"
"    </span>\n"
"    <br/>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">\n"
"        There, your to-dos are listed as\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">private tasks.</font>\n"
"        </span>\n"
"        Any task you create privately will also be included in your to-dos. Essentially, they are interchangeable.\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        برای دسترسی به جریان کاری شخصی خود شامل کارهای روزانه و وظایف محول شده، به ماژول پروژه بروید و روی\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">وظایف من</font>\n"
"        </span>\n"
"        کلیک کنید.\n"
"    </span>\n"
"    <br/>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">\n"
"        در این منو، کارهای روزانه شما به‌عنوان\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">وظایف خصوصی</font>\n"
"        </span>\n"
"        لیست می‌شوند. هر وظیفه‌ای که به‌صورت خصوصی ایجاد کنید نیز در فهرست کارهای روزانه شما قرار خواهد گرفت و به‌طور کلی از هر دو مسیر می‌توانید دسترسی داشته باشید.\n"
"    </span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        By default, to-dos are only visible to you. You can share them with other users by adding them as\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">assignees</font>.\n"
"        </span>\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        به‌طور پیش‌فرض، کارهای روزانه فقط برای شما قابل مشاهده هستند. ولی می‌توانید با افزودن سایر کاربران به‌عنوان\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">مسئول</font>\n"
"        </span>\n"
"        آنها را به اشتراک بگذارید.\n"
"    </span>\n"
"    <br/>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Customize the stages from the\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">Kanban view</font>\n"
"        </span>\n"
"        to reflect your preferred workflow.\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        مراحل را از طریق\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">نمای کانبان</font>\n"
"        </span>\n"
"        مطابق با جریان کاری دلخواه خود سفارشی‌سازی کنید.\n"
"    </span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        If you want to assign your to-do to a specific project, open the ⚙️ menu and click\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">Convert to Task</font>.\n"
"        </span>\n"
"        This action will make it visible to other users.\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        اگر می‌خواهید کار روزانه خود را به یک پروژه مشخص اختصاص دهید، منوی ⚙️ را باز کرده و روی گزینه\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">تبدیل به وظیفه</font>\n"
"        </span>\n"
"        کلیک کنید. با انجام این کار، وظیفه برای سایر کاربران نیز قابل مشاهده خواهد شد.\n"
"    </span>\n"
"    <br/>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Use it to manage your work, take notes on the go, and create tasks based on them.\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        از این ماژول می‌توانید برای مدیریت کارهای خود، یادداشت‌برداری سریع و ایجاد وظایف بر اساس آنها استفاده کنید.\n"
"    </span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Use these keywords in the title to streamline your to-dos:\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        برای تسهیل کارهای قابل انجام، در عنوان از کلمات کلیدی استفاده کنید:\n"
"    </span>\n"
"    <br/>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Wherever you are, use the magic keyboard shortcut to add yourself a reminder &amp;#128161;\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        هر کجا که هستید، از میانبر جادویی صفحه کلید برای اضافه کردن یک یادآوری به خود استفاده کنید &amp;#128161;\n"
"    </span>\n"
"    <br/>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-size: 14px;\">This private to-do is for you to play around with.</span>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">Ready to give it a spin?</span>"
msgstr ""
"<span style=\"font-size: 14px;\">این صفحه، یک کار خصوصی برای تمرین شماست.</span>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">می‌خواهید آن را تست کنید؟</span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid "<span style=\"font-size: 14px;\">Try the following</span>"
msgstr "<span style=\"font-size: 14px;\">موارد زیر را امتحان کنید:</span>"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">!!!:</font>\n"
"            </span>\n"
"            Mark the to-do as urgent"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">!!!:</font>\n"
"            </span>\n"
"            کار را فوری علامت‌گذاری می‌کند"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">!!:</font>\n"
"            </span>\n"
"            Mark the to-do as high priority"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">!!:</font>\n"
"            </span>\n"
"            کار را اولویت بالا علامت‌گذاری می‌کند"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">!:</font>\n"
"            </span>\n"
"            Mark the to-do as medium priority"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">!:</font>\n"
"            </span>\n"
"            کار را دارای اولویت متوسط علامت‌گذاری می‌کند"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">#tags:</font>\n"
"            </span>\n"
"            Add tags to categorize the to-do"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">#tags:</font>\n"
"            </span>\n"
"            برای دسته‌بندی کار برچسب اضافه می‌کند"

#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
#. module: project_todo
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">@user:</font>\n"
"            </span>\n"
"            Assign the to-do to a specific user"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">@user:</font>\n"

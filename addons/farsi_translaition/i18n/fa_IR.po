"                    <div>\n"
"                        <t t-if=\"client_name\">سلام <t t-out=\"client_name\">نام مشتری</t>،</t>\n"
"                        <t t-else=\"\">سلام،</t>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <div>سفارش <t t-out=\"object.tracking_number\">...</t> شما به مبلغ <t t-out=\"object.amount_total\">$xx.xx</t> تأیید شد. <span t-if=\"object.preset_time or client.street\">سفارش </span> <span t-if=\"object.preset_time\">در ساعت <t t-out=\"format_time(time=object.preset_time, tz=tz, time_format='short', lang_code=lg)\">12:00 pm</t></span> <span t-if=\"client.street\">در نشانی <t t-out=\"street\">street</t>، <t t-out=\"state\">state</t>، <t t-out=\"client.zip or ''\">zip</t>، <t t-out=\"city\">city</t>، <t t-out=\"country\">country</t> آماده خواهد شد.</span></div>\n"

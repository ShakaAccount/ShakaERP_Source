msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear\n"
"                    <t t-out=\"object.partner_id.name or ''\">Azure Interior</t>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    This is a reminder that your cheque number <t t-out=\"object.name or ''\">000056</t> for an\n"
"                    amount of <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount, object.currency_id) or ''\">6272.25\n"
"                </span> is due on <t t-out=\"object.check_due_date or ''\">Due Date</t>.\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Please ensure that there is enough balance in your\n"
"                    <t t-if=\"object.partner_bank_id\">\n"
"                        <t t-out=\"object.partner_bank_id.bank_id.name or ''\">NBD Bank</t>\n"
"                    </t>\n"
"                    bank account to cover the cheque amount.\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Best Regards\n"
"                    <t t-if=\"not is_html_empty(object.company_id.pdc_deposit_responsible_id.signature)\">\n"
"                        <br/>\n"
"                        <div t-raw=\"object.company_id.pdc_deposit_responsible_id.signature\"/>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <br/>\n"
"                        --\n"
"                        <br/>\n"
"                        <span t-esc=\"object.company_id.pdc_deposit_responsible_id.name\"/>\n"
"                    </t>\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: hr_payroll
msgid ""
"<code>result</code>: boolean True if the rule should be calculated, False "
"otherwise"
msgstr ""
"<code>result</code>: مقدار بولین؛ اگر قانون باید محاسبه شود True و در غیر "
"این صورت False"

#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
#. module: hr_payroll
msgid "<code>result</code>: float, base amount of the rule"
msgstr "<code>result</code>: عدد اعشاری، مبلغ پایه قانون"

#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
#. module: hr_payroll
msgid ""
"<code>result_name</code>: string, name of the line, which defaults to the "
"name field of the salary rule (useful if the name depends or should depend "
"on something computed in the rule)."
msgstr ""
"<code>result_name</code>: رشته، نام سطر، که به طور پیش‌فرض برابر با فیلد نام"
" قانون حقوق است (در صورتی که نام به چیزی که در قانون محاسبه می‌شود وابسته "
"باشد یا باید وابسته باشد، مفید است)."

#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
#. module: hr_payroll
msgid "<code>result_qty</code>: float, quantity, which defaults to 1."
msgstr ""
"<code>result_qty</code>: عدد اعشاری، مقدار، که به طور پیش‌فرض برابر با ۱ "
"است."

#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
#. module: hr_payroll
msgid ""
"<code>result_rate</code>: float, rate between -100.0 and 100.0, which "
"defaults to 100.0 (%)."
msgstr ""
"<code>result_rate</code>: عدد اعشاری، نرخ بین -۱۰۰.۰ و ۱۰۰.۰، که به طور "
"پیش‌فرض برابر با ۱۰۰.۰ (٪) است."

#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
#. module: hr_payroll
msgid ""
"<code>result_rules</code>: dict containing the rules amounts, quantities, "
"rates and totals (previously computed)"
msgstr ""
"<code>result_rules</code>: دیکشنری شامل مبالغ، مقادیر، نرخ‌ها و مجموع‌های "
"قوانین (که قبلاً محاسبه شده‌اند)"

#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
#. module: hr_payroll
msgid "<code>total = result * result_rate / 100 * result_qty</code>"
msgstr ""


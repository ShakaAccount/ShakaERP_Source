#: model:mail.template,body_html:survey.mail_template_certification
#. module: survey
msgid ""
"<div style=\"background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"    <table style=\"width:600px;margin:5px auto;\">\n"
"        <tbody>\n"
"            <tr><td>\n"
"                <!-- We use the logo of the company that created the survey (to handle multi company cases) -->\n"
"                <a href=\"/\\"><img t-if=\"not object.survey_id.create_uid.company_id.uses_default_logo\" t-attf-src=\"/logo.png?company={{ object.survey_id.create_uid.company_id.id }}\" style=\"vertical-align:baseline;max-width:100px;\"/></a>\n"
"            </td><td style=\"text-align:right;vertical-align:middle;\">\n"
"                    Certification: <t t-out=\"object.survey_id.display_name or ''\">Feedback Form</t>\n"
"            </td></tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <table style=\"width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;\">\n"
"        <tbody>\n"
"            <tr><td style=\"padding:15px 20px 10px 20px;\">\n"
"                <p>Dear <span t-out=\"object.partner_id.name or 'participant'\">participant</span></p>\n"
"                <p>\n"
"                    Please find attached your\n"
"                        <strong t-out=\"object.survey_id.display_name or ''\">Furniture Creation</strong>\n"
"                    certification\n"
"                </p>\n"
"                <p>Congratulations for passing the test with a score of <strong t-out=\"object.scoring_percentage\"/>%!</p>\n"
"            </td></tr>\n"
"        </tbody>\n"
"    </table>\n"
"</div>\n"
"            "
msgstr ""
"<div dir=\"rtl\" style=\"background:#F0F0F0;color:#515166;padding:10px 0px; font-family: IRANSans, IRANSansX, sans-serif;font-size:14px;\">\n"
"    <table style=\"width:600px;margin:5px auto;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td>\n"
"                    <!-- ما از لوگوی شرکتی که نظرسنجی را ایجاد کرده است استفاده می‌کنیم (برای مدیریت حالت‌های چندشرکتی) -->\n"
"                    <a href=\"/\\">\n"
"                        <img t-if=\"not object.survey_id.create_uid.company_id.uses_default_logo\"\n"
"                             t-attf-src=\"/logo.png?company={{ object.survey_id.create_uid.company_id.id }}\"\n"
"                             style=\"vertical-align:baseline;max-width:100px;\"/>\n"
"                    </a>\n"
"                </td>\n"
"                <td style=\"text-align:right;vertical-align:middle;\">\n"
"                    گواهی‌نامه: <t t-out=\"object.survey_id.display_name or ''\">فرم بازخورد</t>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"\n"
"    <table style=\"width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td style=\"padding:15px 20px 10px 20px;\">\n"
"                    <p>\n"
"                        <span t-out=\"object.partner_id.name or 'participant'\">شرکت‌کننده</span> گرامی،\n"
"                    </p>\n"
"                    <p>\n"
"                        گواهی‌نامه مربوط به\n"
"                        <strong t-out=\"object.survey_id.display_name or ''\">ساخت مبلمان</strong>\n"
"                        به پیوست برای شما ارسال شده است.\n"
"                    </p>\n"
"                    <p>\n"
"                        قبولی شما در آزمون با کسب امتیاز\n"
"                        <strong t-out=\"object.scoring_percentage\"/>%\n"
"                        را تبریک می‌گوییم!\n"
"                    </p>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"</div>"

#: model:mail.template,body_html:survey.mail_template_user_input_invite
#. module: survey
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name or 'participant'\">participant</t><br/><br/>\n"
"        <t t-if=\"object.survey_id.certification\">\n"
"            You have been invited to take a new certification.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            We are conducting a survey and your response would be appreciated.\n"
"        </t>\n"
"        </p><div style=\"margin: 16px 0px 16px 0px;\">\n"
"            <a t-att-href=\"(object.get_start_url())\" t-attf-style=\"background-color: {{user.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"                <t t-if=\"object.survey_id.certification\">\n"
"                    Start Certification\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    Start Survey\n"
"                </t>\n"
"            </a>\n"
"        </div>\n"
"        <t t-if=\"object.deadline\">\n"
"            Please answer the survey for <t t-out=\"format_date(object.deadline) or ''\">05/05/2021</t>.<br/><br/>\n"
"        </t>\n"
"        <t t-if=\"object.survey_id.certification\">\n"
"            We wish you good luck!\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            Thank you in advance for your participation.\n"
"        </t>\n"
"    \n"
"</div>\n"
"            "
msgstr ""
"<div dir=\"rtl\" style=\"margin: 0px; padding: 0px; font-size: 13px; font-family: IRANSans, IRANSansX;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        <t t-out=\"object.partner_id.name or 'participant'\">شرکت‌کننده</t> گرامی،<br/><br/>\n"
"        <t t-if=\"object.survey_id.certification\">\n"
"            از شما دعوت می‌شود در یک فرایند گواهی‌نامه جدید شرکت نمایید.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            ما در حال برگزاری یک نظرسنجی هستیم و از مشارکت شما استقبال می‌کنیم.\n"
"        </t>\n"
"    </p>\n"
"\n"
"    <div style=\"margin: 16px 0px 16px 0px;\">\n"
"        <a t-att-href=\"(object.get_start_url())\"\n"
"           t-attf-style=\"background-color: {{user.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"

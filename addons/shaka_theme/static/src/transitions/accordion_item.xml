<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Accordion (transitions.dev): two-element grid panel, kept mounted while
         it collapses (accordion_item.js). -->
    <t t-inherit="web.AccordionItem" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_accordion')]" position="attributes">
            <attribute name="class" add="t-acc" separator=" "/>
            <attribute name="t-att-data-open">state.open ? 'true' : 'false'</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_accordion_toggle')]" position="attributes">
            <attribute name="t-on-click">toggle</attribute>
        </xpath>
        <xpath expr="//t[@t-if='state.open']" position="replace">
            <div t-if="state.open or state.closing" class="t-acc-panel">
                <div class="t-acc-panel-inner">
                    <div class="o_accordion_values ms-4 border-start">
                        <t t-slot="default"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>

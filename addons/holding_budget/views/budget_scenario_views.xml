<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_holding_budget_scenario_list" model="ir.ui.view">
        <field name="name">holding.budget.scenario.list</field>
        <field name="model">holding.budget.scenario</field>
        <field name="arch" type="xml">
            <list string="سناریوهای بودجه">
                <field name="company_id"/>
                <field name="fiscal_year_id"/>
            </list>
        </field>
    </record>

    <record id="view_holding_budget_scenario_form" model="ir.ui.view">
        <field name="name">holding.budget.scenario.form</field>
        <field name="model">holding.budget.scenario</field>
        <field name="arch" type="xml">
            <form string="سناریوهای بودجه">
                <sheet>
                    <field name="name" invisible="1"/>
                    <group>
                        <field name="company_id"/>
                        <field name="fiscal_year_id"/>
                    </group>
                    <separator string="جزئیات سناریوهای بودجه"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" default_order="sequence,id">
                            <field name="sequence" widget="handle" optional="hide"/>
                            <field name="scenario_name" string="عنوان سناریو" width="260px"/>
                            <field name="description" string="توضیحات" width="420px"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_holding_budget_scenario" model="ir.actions.act_window">
        <field name="name">سناریوهای بودجه</field>
        <field name="res_model">holding.budget.scenario</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_holding_budget_root"
              name="بودجه هلدینگ"
              sequence="80"
              web_icon="holding_budget,static/description/icon.svg"
              groups="base.group_user"/>
    <menuitem id="menu_holding_budget_scenario"
              name="سناریوهای بودجه"
              parent="menu_holding_budget_root"
              action="action_holding_budget_scenario"
              sequence="10"/>
</odoo>

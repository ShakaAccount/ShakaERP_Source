<odoo>
    <record id="group_leave_admin" model="res.groups">
        <field name="name">Leave Admin</field>
    </record>

    <record id="rule_leave_own" model="ir.rule">
        <field name="name">Leave Request: own records only</field>
        <field name="model_id" ref="model_leave_request"/>
        <field name="domain_force">[('employee_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_leave_admin_all" model="ir.rule">
        <field name="name">Leave Request: admin sees all</field>
        <field name="model_id" ref="model_leave_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_leave_admin'))]"/>
    </record>
</odoo>

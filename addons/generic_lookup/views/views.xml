<odoo>
    <record id="view_lookup_type_list" model="ir.ui.view">
        <field name="name">lookup.type.list</field>
        <field name="model">lookup.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="value_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_lookup_type_form" model="ir.ui.view">
        <field name="name">lookup.type.form</field>
        <field name="model">lookup.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Values">
                            <field name="value_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lookup_type" model="ir.actions.act_window">
        <field name="name">Lookup Types</field>
        <field name="res_model">lookup.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

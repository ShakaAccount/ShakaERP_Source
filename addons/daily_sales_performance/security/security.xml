        <field name="name">عملکرد روزانه: شعبه‌های کاربر</field>
        <field name="model_id" ref="model_daily_sales_performance"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id', 'in', user.shaka_branch_access_ids.mapped('branch_id').ids)] if user.shaka_branch_access_ids else [(1, '=', 1)]</field>

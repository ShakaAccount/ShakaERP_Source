<odoo>
    <record id="view_daily_sales_deposit_split_list" model="ir.ui.view">
        <field name="name">daily.sales.deposit.split.list</field>
        <field name="model">daily.sales.deposit.split</field>
        <field name="arch" type="xml">
            <list class="shaka-sales-list">
                <field name="name" string="شماره"/>
                <field name="date" string="تاریخ"/>
                <field name="branch_id" string="شعبه"/>
                <field name="performance_id" string="عملکرد روزانه"/>
                <field name="total_pos_amount" string="جمع پوز (ریال)"/>
                <field name="total_deposit_amount" string="جمع واریزی (ریال)"/>
                <field name="balance_amount" string="مانده (ریال)"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_daily_sales_deposit_split_form" model="ir.ui.view">
        <field name="name">daily.sales.deposit.split.form</field>
        <field name="model">daily.sales.deposit.split</field>
        <field name="arch" type="xml">
            <form string="تفکیک واریزی" class="shaka-sales-form shaka-deposit-form">
                <header>
                    <button name="action_submit" type="object" string="ارسال برای تأیید" icon="fa-paper-plane"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="تأیید" icon="fa-check"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="رد" icon="fa-times"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet class="shaka-sales-sheet">
                    <div class="shaka-form-hero">
                        <div class="shaka-form-hero__content">
                            <div><h1>تفکیک واریزی</h1></div>
                            <div class="shaka-form-number"><span>شماره سند</span><strong><field name="name" readonly="1" nolabel="1"/></strong></div>
                        </div>
                    </div>

                    <div class="shaka-info-panel"><group class="shaka-main-info">
                        <group>
                            <field name="performance_id" string="عملکرد روزانه *"
                                   context="{'tree_view_ref': 'daily_sales_performance.view_daily_sales_performance_selection_list'}"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="date" string="تاریخ" readonly="1"/>
                            <field name="branch_id" string="شعبه" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                        </group>
                    </group></div>

                    <div class="shaka-kpi-grid shaka-kpi-grid--three">
                        <div class="shaka-kpi-card shaka-kpi-card--dark"><div class="shaka-kpi-icon"><i class="fa fa-credit-card" role="img" aria-label="پوز"/></div><div><span>جمع مبلغ پوز</span><field name="total_pos_amount" readonly="1" nolabel="1"/></div><small>ریال</small></div>
                        <div class="shaka-kpi-card shaka-kpi-card--green"><div class="shaka-kpi-icon"><i class="fa fa-check" role="img" aria-label="واریزی"/></div><div><span>جمع واریزی</span><field name="total_deposit_amount" readonly="1" nolabel="1"/></div><small>ریال</small></div>
                        <div class="shaka-kpi-card shaka-kpi-card--white"><div class="shaka-kpi-icon"><i class="fa fa-balance-scale" role="img" aria-label="تطبیق"/></div><div><span>مانده تطبیق</span><field name="balance_amount" readonly="1" nolabel="1"/></div><small>ریال</small></div>
                    </div>

                    <div class="shaka-data-panel">
                    <div class="shaka-section-heading"><div class="shaka-section-icon"><i class="fa fa-list-alt" role="img" aria-label="پوزهای عملکرد"/></div><div><h3>پوزهای عملکرد روزانه</h3></div></div>
                    <field name="pos_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="terminal_number" string="شماره ترمینال پوز" readonly="1"/>
                            <field name="pos_amount" string="مبلغ پوز (ریال)" readonly="1"/>
                            <field name="total_deposit_amount" string="جمع واریزی (ریال)" readonly="1"/>
                            <field name="balance_amount" string="مانده (ریال)" readonly="1"/>
                        </list>
                    </field>
                    </div>

                    <div class="shaka-data-panel">
                    <div class="shaka-section-heading"><div class="shaka-section-icon"><i class="fa fa-bank" role="img" aria-label="واریزی‌های بانکی"/></div><div><h3>جزئیات واریزی هر پوز</h3></div></div>
                    <field name="deposit_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="performance_pos_id" string="ترمینال پوز *"
                                   domain="[('performance_id', '=', parent.performance_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="deposit_date" string="تاریخ واریز *" widget="date"/>
                            <field name="deposit_time" string="ساعت واریز *" widget="float_time"/>
                            <field name="deposit_amount" string="مبلغ واریزی (ریال) *"/>
                            <field name="description" string="توضیحات"/>
                        </list>
                    </field>
                    </div>
                    <field name="reject_reason" placeholder="دلیل رد..."
                           invisible="state != 'rejected'"/>
                    <div class="shaka-form-hint">فیلدهای دارای * اجباری هستند.</div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_daily_sales_deposit_split" model="ir.actions.act_window">
        <field name="name">تفکیک واریزی</field>
        <field name="res_model">daily.sales.deposit.split</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_daily_sales_deposit_split" name="تفکیک واریزی"
              parent="menu_daily_sales_root" action="action_daily_sales_deposit_split" sequence="15"/>
</odoo>

<odoo>
    <record id="view_daily_sales_return_list" model="ir.ui.view">
        <field name="name">daily.sales.return.list</field>
        <field name="model">daily.sales.return</field>
        <field name="arch" type="xml">
            <list class="shaka-sales-list">
                <field name="name" string="شماره سند"/>
                <field name="date" string="تاریخ"/>
                <field name="branch_id" string="شعبه"/>
                <field name="created_by" string="ایجادکننده"/>
                <field name="total_returned_amount" string="جمع عودت (ریال)" sum="جمع عودت"/>
                <field name="state" string="وضعیت" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_daily_sales_return_form" model="ir.ui.view">
        <field name="name">daily.sales.return.form</field>
        <field name="model">daily.sales.return</field>
        <field name="arch" type="xml">
            <form string="عودت" class="shaka-sales-form shaka-return-form">
                <header>
                    <button name="action_submit" type="object" string="ارسال برای تأیید" icon="fa-paper-plane" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="تأیید" icon="fa-check" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="رد" icon="fa-times" invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" type="object" string="بازگشت به پیش‌نویس" icon="fa-undo" invisible="state not in ('rejected', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet class="shaka-sales-sheet">
                    <div class="shaka-form-hero">
                        <div class="shaka-form-hero__content">
                            <h1>عودت</h1>
                            <div class="shaka-form-number"><span>شماره سند</span><strong><field name="name" readonly="1" nolabel="1"/></strong></div>
                        </div>
                    </div>
                    <div class="shaka-info-panel">
                        <group class="shaka-main-info">
                            <group>
                                <field name="date" string="تاریخ *"/>
                                <field name="branch_id" string="شعبه *" readonly="id"/>
                                <field name="created_by" string="ایجادکننده *" readonly="1"/>
                            </group>
                        </group>
                    </div>
                    <div class="shaka-kpi-grid shaka-kpi-grid--three">
                        <div class="shaka-kpi-card shaka-kpi-card--green">
                            <div class="shaka-kpi-icon"><i class="fa fa-undo" role="img" aria-label="عودت"/></div>
                            <div><span>جمع کل عودت</span><field name="total_returned_amount" readonly="1" nolabel="1"/></div>
                            <small>ریال</small>
                        </div>
                    </div>
                    <div class="shaka-data-panel">
                        <div class="shaka-section-heading"><div class="shaka-section-icon"><i class="fa fa-reply" role="img" aria-label="جزئیات عودت"/></div><div><h3>جزئیات عودت</h3></div></div>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="invoice_number" string="شماره فاکتور *"/>
                                <field name="customer_name" string="نام و نام خانوادگی *"/>
                                <field name="bank_card_number" string="شماره کارت بانکی *"/>
                                <field name="phone" string="تلفن *"/>
                                <field name="invoice_amount" string="مبلغ فاکتور (ریال) *"/>
                                <field name="return_reason" string="دلیل عودت *"/>
                                <field name="payment_confirmed" string="تأیید پرداخت"/>
                                <field name="returned_amount" string="مبلغ عودت‌داده‌شده (ریال) *"/>
                                <field name="description" string="توضیحات"/>
                            </list>
                        </field>
                    </div>
                    <field name="reject_reason" string="دلیل رد" placeholder="دلیل رد..." invisible="state != 'rejected'"/>
                    <div class="shaka-form-hint">فیلدهای دارای * اجباری هستند.</div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_daily_sales_return" model="ir.actions.act_window">
        <field name="name">عودت‌ها</field>
        <field name="res_model">daily.sales.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_daily_sales_return" name="عودت" parent="menu_daily_sales_root" action="action_daily_sales_return" sequence="18"/>
</odoo>

<odoo>
    <record id="view_daily_sales_corrective_invoice_list" model="ir.ui.view">
        <field name="name">daily.sales.corrective.invoice.list</field>
        <field name="model">daily.sales.corrective.invoice</field>
        <field name="arch" type="xml">
            <list class="shaka-sales-list">
                <field name="name" string="شماره"/>
                <field name="date" string="تاریخ"/>
                <field name="branch_id" string="شعبه"/>
                <field name="created_by" string="ثبت‌کننده"/>
                <field name="state" string="وضعیت" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_daily_sales_corrective_invoice_form" model="ir.ui.view">
        <field name="name">daily.sales.corrective.invoice.form</field>
        <field name="model">daily.sales.corrective.invoice</field>
        <field name="arch" type="xml">
            <form string="فاکتور اصلاحی" class="shaka-sales-form shaka-corrective-invoice-form">
                <header>
                    <button name="action_submit" type="object" string="ارسال برای تأیید" icon="fa-paper-plane" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="تأیید" icon="fa-check" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="رد" icon="fa-times" invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" type="object" string="بازگشت به پیش‌نویس" icon="fa-undo" invisible="state not in ('rejected', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet class="shaka-sales-sheet">
                    <div class="shaka-form-hero">
                        <div class="shaka-form-hero__content">
                            <div><h1>فاکتور اصلاحی</h1></div>
                            <div class="shaka-form-number"><span>شماره سند</span><strong><field name="name" readonly="1" nolabel="1"/></strong></div>
                        </div>
                    </div>
                    <div class="shaka-info-panel">
                        <group class="shaka-main-info">
                            <group>
                                <field name="date" string="تاریخ *"/>
                                <field name="branch_id" string="شعبه *" readonly="id"/>
                                <field name="created_by" string="ثبت‌کننده *" readonly="1"/>
                            </group>
                        </group>
                    </div>
                    <div class="shaka-data-panel">
                        <div class="shaka-section-heading"><div class="shaka-section-icon"><i class="fa fa-file-text-o" role="img" aria-label="فاکتورها"/></div><div><h3>فاکتورهای اصلاحی</h3></div></div>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="invalid_invoice_number" string="شماره فاکتور ابطالی *"/>
                                <field name="replacement_invoice_number" string="شماره فاکتور اصلاحی"/>
                                <field name="invalid_invoice_amount" string="مبلغ فاکتور ابطالی (ریال) *"/>
                            </list>
                        </field>
                    </div>
                    <field name="reject_reason" string="دلیل رد" placeholder="دلیل رد..." invisible="state != 'rejected'"/>
                    <div class="shaka-form-hint">فیلدهای دارای * اجباری هستند.</div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_daily_sales_corrective_invoice" model="ir.actions.act_window">
        <field name="name">فاکتورهای اصلاحی</field>
        <field name="res_model">daily.sales.corrective.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_daily_sales_corrective_invoice" name="فاکتور اصلاحی" parent="menu_daily_sales_root" action="action_daily_sales_corrective_invoice" sequence="17"/>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="win_access.PbirsTree">
        <div class="o_win_access_tree" t-ref="root">
            <div class="o_wa_toolbar d-flex align-items-center gap-2 mb-2">
                <input type="search" class="form-control w-auto flex-grow-1"
                       placeholder="Search folders and reports…" t-model="state.query"/>
                <button type="button" class="btn btn-light" t-on-click="() => this.expandAll(true)">Expand all</button>
                <button type="button" class="btn btn-light" t-on-click="() => this.expandAll(false)">Collapse all</button>
                <span class="badge text-bg-secondary" t-out="count + ' of ' + total + ' selected'"/>
            </div>
            <div class="o_wa_rows border rounded p-2">
                <div t-if="!rootNodes.length" class="text-muted">
                    <t t-if="total">Nothing matches "<t t-out="state.query"/>".</t>
                    <t t-else="">No PBIRS items loaded. Check the API settings.</t>
                </div>
                <t t-foreach="rootNodes" t-as="node" t-key="node.id">
                    <TreeNode
                            node="node"
                            children="getChildren(node)"
                            expandedIds="effectiveOpen"
                            closingIds="state.closing"
                            onToggle="(id) => this.toggleNode(id)"
                            disabled="props.readonly"
                            showCheckbox="true"
                            checkState="checkState"
                            onCheck="(n, checked) => this.onCheck(n, checked)"
                            getChildren="getChildren"
                            level="0"
                            index="node_index">
                        <t t-set-slot="icon" t-slot-scope="ctx">
                            <i t-attf-class="fa {{ ctx.node.hasChildren ? 'fa-folder-o' : 'fa-bar-chart' }} o_wa_icon me-2"/>
                        </t>
                        <t t-set-slot="extra" t-slot-scope="ctx">
                            <small class="text-muted ms-2" t-out="ctx.node.item_type"/>
                        </t>
                    </TreeNode>
                </t>
            </div>
        </div>
    </t>
</templates>

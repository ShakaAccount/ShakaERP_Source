<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_plan_list" model="ir.ui.view">
        <field name="name">budget.plan.list</field>
        <field name="model">budget.plan</field>
        <field name="arch" type="xml">
            <list string="برنامه‌ها و بودجه‌ها">
                <field name="number" string="شماره"/>
                <field name="name" string="عنوان برنامه"/>
                <field name="company_id"/>
                <field name="fiscal_year_id" string="سال مالی"/>
                <field name="owner_role_id" string="متولی"/>
                <field name="state" widget="badge"/>
                <field name="budget_total" string="بودجه مصوب"/>
                <field name="budget_consumption" string="درصد مصرف"/>
            </list>
        </field>
    </record>

    <record id="view_budget_plan_form" model="ir.ui.view">
        <field name="name">budget.plan.form</field>
        <field name="model">budget.plan</field>
        <field name="arch" type="xml">
            <form string="برنامه و بودجه">
                <sheet>
                    <field name="state" invisible="1"/>
                    <div class="bp-top">
                        <div class="bp-unlocked-source"><field name="unlocked_step" readonly="1" nolabel="1"/></div>
                        <div class="bp-title"><div class="bp-mark"><field name="number" readonly="1" nolabel="1"/></div><div><h1>بودجه و برنامه‌ریزی</h1><p>ثبت مرحله‌ای برنامه و بودجه سالانه</p></div></div>
                        <div class="bp-actions">
                            <button name="action_unlock_next_step" string="ثبت و رفتن به مرحله بعد" type="object" class="bp-btn primary bp-next-step" context="{'bp_step': 1}" data-bp-step="1" invisible="state != 'draft'"/>
                            <button name="action_unlock_next_step" string="ثبت و رفتن به مرحله بعد" type="object" class="bp-btn primary bp-next-step" context="{'bp_step': 2}" data-bp-step="2" invisible="state != 'draft'"/>
                            <button name="action_unlock_next_step" string="ثبت و رفتن به مرحله بعد" type="object" class="bp-btn primary bp-next-step" context="{'bp_step': 3}" data-bp-step="3" invisible="state != 'draft'"/>
                            <button name="action_unlock_next_step" string="ثبت و رفتن به مرحله بعد" type="object" class="bp-btn primary bp-next-step" context="{'bp_step': 4}" data-bp-step="4" invisible="state != 'draft'"/>
                            <button name="action_unlock_next_step" string="ثبت و رفتن به مرحله بعد" type="object" class="bp-btn primary bp-next-step" context="{'bp_step': 5}" data-bp-step="5" invisible="state != 'draft'"/>
                            <button name="action_unlock_next_step" string="ثبت و رفتن به مرحله بعد" type="object" class="bp-btn primary bp-next-step" context="{'bp_step': 6}" data-bp-step="6" invisible="state != 'draft'"/>
                            <button name="action_submit" string="تأیید نهایی و ارسال برای بررسی" type="object" class="bp-btn primary bp-final-submit" invisible="state != 'draft'"/>
                            <button name="action_approve" string="تأیید" type="object" class="bp-btn primary" invisible="state != 'submitted'"/>
                            <button name="action_reject" string="رد" type="object" class="bp-btn" invisible="state != 'submitted'"/>
                            <button name="action_reset_draft" string="بازگشت به پیش‌نویس" type="object" class="bp-btn" invisible="state not in ('rejected', 'approved')"/>
                        </div>
                    </div>
                    <section class="bp-card bp-header">
                        <div class="bp-header-grid">
                            <div class="bp-field"><label for="name">عنوان برنامه *</label><field name="name" placeholder="برنامه عملیاتی و بودجه سالانه..."/></div>
                            <div class="bp-field"><label for="number">شماره برنامه</label><field name="number" readonly="1"/></div>
                            <div class="bp-field"><label for="fiscal_year_id">سال مالی *</label><field name="fiscal_year_id" required="1"/></div>
                            <div class="bp-field"><label for="company_id">واحد سازمانی *</label><field name="company_id" required="1"/></div>
                        </div>
                        <div class="bp-header-grid bp-header-secondary">
                            <div class="bp-field bp-field-wide"><label for="description">توضیحات</label><field name="description" placeholder="توضیحات برنامه..."/></div>
                        </div>
                    </section>
                    <div class="bp-shell">
                        <aside class="bp-card bp-steps">
                            <div class="bp-step active" data-bp-page="strategies"><span class="bp-step-number">۱</span><span><strong>استراتژی</strong><small>برنامه‌های کلان</small></span></div>
                            <div class="bp-step" data-bp-page="targets"><span class="bp-step-number">۲</span><span><strong>اهداف</strong><small>هدف‌های قابل‌اندازه‌گیری</small></span></div>
                            <div class="bp-step" data-bp-page="kpis"><span class="bp-step-number">۳</span><span><strong>KPIها</strong><small>شاخص‌های عملکرد</small></span></div>
                            <div class="bp-step" data-bp-page="initiatives"><span class="bp-step-number">۴</span><span><strong>اقدامات</strong><small>چند اقدام برای هر KPI</small></span></div>
                            <div class="bp-step" data-bp-page="projects"><span class="bp-step-number">۵</span><span><strong>پروژه‌ها</strong><small>تقسیم اقدام‌ها</small></span></div>
                            <div class="bp-step" data-bp-page="activities"><span class="bp-step-number">۶</span><span><strong>فعالیت‌ها</strong><small>فعالیت‌های اجرایی</small></span></div>
                            <div class="bp-step" data-bp-page="budget"><span class="bp-step-number">۷</span><span><strong>تخصیص بودجه</strong><small>کنترل مصرف</small></span></div>
                        </aside>
                        <div class="bp-main">
                    <notebook>
                        <page string="استراتژی‌ها" name="strategies">
                            <field name="strategy_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="title" required="1"/>
                                    <field name="horizon_start" optional="hide"/>
                                    <field name="horizon_end" optional="hide"/>
                                    <field name="owner_role_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="اهداف" name="targets">
                            <field name="target_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="strategy_id" required="1" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="title" required="1"/>
                                    <field name="current_value" optional="hide"/>
                                    <field name="target_value" required="1"/>
                                    <field name="unit_id" required="1" options="{'no_create_edit': False}" context="{'default_type_code': 'budget_measurement_unit'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="KPIها" name="kpis">
                            <field name="kpi_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="target_id" required="1" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="title" required="1"/>
                                    <field name="unit_id" required="1" options="{'no_create_edit': False}" context="{'default_type_code': 'budget_measurement_unit'}"/>
                                    <field name="target_value" required="1"/>
                                    <field name="weight" optional="hide"/>
                                    <field name="current_value" optional="hide"/>
                                    <field name="achievement" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="اقدامات" name="initiatives">
                            <field name="initiative_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="kpi_id" required="1" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="title" required="1"/>
                                    <field name="owner_role_id" string="مالک اقدام" optional="hide"/>
                                    <field name="weight" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="پروژه‌ها" name="projects">
                            <field name="project_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="initiative_id" required="1" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="title" required="1"/>
                                    <field name="responsible_role_id" string="مسئول پروژه" optional="hide"/>
                                    <field name="date_start" optional="hide"/>
                                    <field name="date_end" optional="hide"/>
                                    <field name="approved_amount" optional="hide"/>
                                    <field name="actual_amount" optional="hide"/>
                                    <field name="physical_progress" optional="hide"/>
                                    <field name="financial_progress" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="فعالیت‌ها" name="activities">
                            <field name="activity_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="project_id" required="1" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="title" required="1"/>
                                    <field name="quantity" optional="hide"/>
                                    <field name="unit_id" optional="hide" options="{'no_create_edit': False}" context="{'default_type_code': 'budget_measurement_unit'}"/>
                                    <field name="cost" optional="hide"/>
                                    <field name="status_id" optional="hide" options="{'no_create_edit': False}" context="{'default_type_code': 'budget_activity_status'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="تخصیص بودجه" name="budget">
                            <field name="budget_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="number" readonly="1" optional="hide"/>
                                    <field name="initiative_id" required="1" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="title" required="1"/>
                                    <field name="approved_amount" optional="hide"/>
                                    <field name="allocated_amount" optional="hide"/>
                                    <field name="spent_amount" optional="hide"/>
                                    <field name="consumption" readonly="1" optional="hide"/>
                                    <field name="balance" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_budget_dashboard_kanban" model="ir.ui.view">
        <field name="name">budget.plan.dashboard.kanban</field>
        <field name="model">budget.plan.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="bp-dashboard-kanban" create="0" edit="0" delete="0">
                <field name="plan_name"/>
                <field name="year"/>
                <field name="strategy_count"/>
                <field name="target_count"/>
                <field name="kpi_count"/>
                <field name="initiative_count"/>
                <field name="project_count"/>
                <field name="activity_count"/>
                <field name="budget_total"/>
                <field name="budget_spent"/>
                <field name="budget_consumption"/>
                <templates>
                    <t t-name="card">
                        <article class="bp-dash-card">
                            <div class="bp-dash-head"><div><h2><t t-esc="record.plan_name.value"/></h2><span><t t-esc="record.year.value"/></span></div><i class="fa fa-line-chart" role="img" aria-label="داشبورد"/></div>
                            <div class="bp-dash-stats">
                                <div><small>استراتژی</small><strong><t t-esc="record.strategy_count.value"/></strong></div>
                                <div><small>هدف</small><strong><t t-esc="record.target_count.value"/></strong></div>
                                <div><small>KPI</small><strong><t t-esc="record.kpi_count.value"/></strong></div>
                                <div><small>اقدام</small><strong><t t-esc="record.initiative_count.value"/></strong></div>
                                <div><small>پروژه</small><strong><t t-esc="record.project_count.value"/></strong></div>
                                <div><small>فعالیت</small><strong><t t-esc="record.activity_count.value"/></strong></div>
                            </div>
                            <div class="bp-dash-budget"><div class="bp-dash-budget-row"><span>مصرف بودجه</span><strong><t t-esc="record.budget_consumption.value"/>٪</strong></div><div class="bp-dash-bar"><span t-att-style="'width: ' + Math.min(record.budget_consumption.raw_value || 0, 100) + '%'"/></div><div class="bp-dash-money"><span>مصوب: <t t-esc="record.budget_total.value"/></span><span>مصرف: <t t-esc="record.budget_spent.value"/></span></div></div>
                        </article>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_budget_plan" model="ir.actions.act_window">
        <field name="name">برنامه‌ها و بودجه‌ها</field>
        <field name="res_model">budget.plan</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_budget_dashboard" model="ir.actions.act_window">
        <field name="name">داشبورد برنامه و بودجه</field>
        <field name="res_model">budget.plan.dashboard</field>
        <field name="view_mode">kanban</field>
    </record>

    <menuitem id="menu_budget_planning_root" name="برنامه و بودجه" sequence="82" web_icon="budget_planning,static/description/icon.svg"/>
    <menuitem id="menu_budget_plan" name="برنامه‌ها و بودجه‌ها" parent="menu_budget_planning_root" action="action_budget_plan" sequence="10"/>
    <menuitem id="menu_budget_dashboard" name="داشبورد برنامه و بودجه" parent="menu_budget_planning_root" action="action_budget_dashboard" sequence="20"/>
</odoo>

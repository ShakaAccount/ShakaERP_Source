<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================================
         ShakaERP Skeuomorphic UI - Web Client Templates
         Theming is primarily done via SCSS asset bundles (backend.scss, login.scss).
         These XML templates only handle the login-page structural overrides and
         add a few semantic class hooks. All hooks are wrapped so a missing base
         node degrades gracefully instead of blocking module installation.
         ============================================================================ -->

    <!-- Login Layout - Skeuomorphic redesign (uses literal class anchors like my_debrand) -->
    <template id="login_layout" name="Shaka Skeuomorphic Login Layout" inherit_id="web.login_layout">
        <!-- Replace the logo block with skeuomorphic logo + title -->
        <xpath expr="//div[hasclass('text-center', 'pb-3', 'border-bottom', 'mb-4')]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4 shaka-login-brand">
                <img src="/shaka_skeuomorphic_ui/static/img/logo.png" alt="ShakaERP" class="img-fluid shaka-login-logo" style="max-height:120px; max-width: 100%; width:auto"/>
                <h2 class="oe_login_db_name mt-3 mb-0" t-esc="dbname or 'ShakaERP'"/>
            </div>
        </xpath>

        <!-- Replace the footer with skeuomorphic footer -->
        <xpath expr="//div[hasclass('text-center', 'small', 'mt-4', 'pt-3', 'border-top')]" position="replace">
            <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                <t t-if="not disable_database_manager">
                    <a class="border-end pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                </t>
                <span class="text-muted">ShakaERP</span>
            </div>
        </xpath>
    </template>

    <!-- Login Page - Skeuomorphic login form (add pre-icon slots) -->
    <template id="login" name="Shaka Skeuomorphic Login" inherit_id="web.login">
        <!-- Add icon to the password field -->
        <xpath expr="//div[hasclass('o_caps_lock_warning')]//input[@name='password']" position="before">
            <span class="input-group-text shaka-input-icon">
                <i class="fa fa-lock" aria-hidden="true"/>
            </span>
        </xpath>
        <!-- Add icon to the login field -->
        <xpath expr="//div[hasclass('field-login')]//input[@name='login']" position="before">
            <span class="input-group-text shaka-input-icon">
                <i class="fa fa-user" aria-hidden="true"/>
            </span>
        </xpath>
    </template>
</odoo>
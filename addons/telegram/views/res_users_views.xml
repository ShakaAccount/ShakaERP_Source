<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_preferences_telegram" model="ir.ui.view">
        <field name="name">res.users.preferences.form.telegram</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <label for="telegram_notify"/>
                <div class="o_row">
                    <field name="telegram_chat_id" invisible="1"/>
                    <field name="telegram_notify" readonly="0" invisible="not telegram_chat_id"/>
                    <button name="action_telegram_connect" type="object" string="Connect Telegram"
                            class="btn-link p-0" icon="fa-paper-plane" invisible="telegram_chat_id"/>
                    <button name="action_telegram_disconnect" type="object" string="Disconnect"
                            class="btn-link p-0" invisible="not telegram_chat_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

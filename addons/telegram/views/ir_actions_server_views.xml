<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_view_form_telegram" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.telegram</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@name='action_content']" position="inside">
                <group invisible="state != 'telegram'">
                    <group>
                        <field name="telegram_template_id"
                               placeholder="Choose a template..."
                               required="state == 'telegram'"
                               options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

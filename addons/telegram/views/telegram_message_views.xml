<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="telegram_message_view_list" model="ir.ui.view">
        <field name="name">telegram.message.list</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'error'" decoration-muted="state == 'outgoing'">
                <field name="create_date"/>
                <field name="message_type"/>
                <field name="partner_id"/>
                <field name="chat_id" optional="hide"/>
                <field name="body"/>
                <field name="state" widget="badge"/>
                <field name="failure_reason" optional="show"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-repeat" invisible="state != 'error'"/>
            </list>
        </field>
    </record>

    <record id="telegram_message_view_form" model="ir.ui.view">
        <field name="name">telegram.message.form</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry" invisible="state != 'error'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bot_id"/>
                            <field name="partner_id"/>
                            <field name="chat_id"/>
                            <field name="message_type"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="tg_message_id"/>
                            <field name="mail_message_id"/>
                            <field name="failure_reason" invisible="not failure_reason"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="telegram_message_view_search" model="ir.ui.view">
        <field name="name">telegram.message.search</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="body"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'error')]"/>
                <filter name="queued" string="In Queue" domain="[('state', '=', 'outgoing')]"/>
                <separator/>
                <filter name="inbound" string="Inbound" domain="[('message_type', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('message_type', '=', 'outbound')]"/>
            </search>
        </field>
    </record>

    <record id="telegram_message_action" model="ir.actions.act_window">
        <field name="name">Telegram Messages</field>
        <field name="res_model">telegram.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="telegram_template_view_list" model="ir.ui.view">
        <field name="name">telegram.template.list</field>
        <field name="model">telegram.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="telegram_template_view_form" model="ir.ui.view">
        <field name="name">telegram.template.form</field>
        <field name="model">telegram.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_sidebar_action" type="object" string="Add to Actions Menu"
                            invisible="sidebar_action_id" help="Add a 'Send Telegram' entry to the Actions menu of this model"/>
                    <button name="action_unlink_sidebar_action" type="object" string="Remove from Actions Menu"
                            invisible="not sidebar_action_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Order confirmation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model" invisible="1"/>
                            <field name="report_id" invisible="not model" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sidebar_action_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="body" placeholder="Hello {{ object.partner_id.name }}, ..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="telegram_template_action" model="ir.actions.act_window">
        <field name="name">Telegram Templates</field>
        <field name="res_model">telegram.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

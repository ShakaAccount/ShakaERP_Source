<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="telegram_bot_view_list" model="ir.ui.view">
        <field name="name">telegram.bot.list</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bot_username"/>
                <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="telegram_bot_view_form" model="ir.ui.view">
        <field name="name">telegram.bot.form</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Shaka Bot"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="token" password="True"/>
                            <field name="bot_username"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                            <field name="notify_user_ids" widget="many2many_tags"/>
                            <field name="update_offset"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="telegram_bot_action" model="ir.actions.act_window">
        <field name="name">Telegram Bots</field>
        <field name="res_model">telegram.bot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect a Telegram bot</p>
            <p>Create a bot with @BotFather in Telegram and paste its token here.</p>
        </field>
    </record>
</odoo>

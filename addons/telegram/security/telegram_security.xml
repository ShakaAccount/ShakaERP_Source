<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_telegram" model="res.groups.privilege">
        <field name="name">Telegram</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_telegram_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_telegram"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_telegram_bot_company" model="ir.rule">
            <field name="name">Telegram Bot: allowed companies</field>
            <field name="model_id" ref="model_telegram_bot"/>
            <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
        </record>
        <record id="rule_telegram_template_company" model="ir.rule">
            <field name="name">Telegram Template: allowed companies</field>
            <field name="model_id" ref="model_telegram_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_telegram_composer_own" model="ir.rule">
            <field name="name">Telegram Composer: own</field>
            <field name="model_id" ref="model_telegram_composer"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>
    </data>
</odoo>

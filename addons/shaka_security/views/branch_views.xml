<odoo>
    <record id="view_daily_sales_branch_list" model="ir.ui.view">
        <field name="name">daily.sales.branch.list</field>
        <field name="model">daily.sales.branch</field>
        <field name="arch" type="xml">
            <list><field name="branchid"/><field name="name"/><field name="user_ids" widget="many2many_tags" invisible="1"/></list>
        </field>
    </record>
    <record id="view_daily_sales_branch_form" model="ir.ui.view">
        <field name="name">daily.sales.branch.form</field>
        <field name="model">daily.sales.branch</field>
        <field name="arch" type="xml">
            <form string="شعبه"><sheet><group>
                <field name="branchid" readonly="1"/><field name="name" readonly="1"/>
                <field name="companyid" readonly="1"/><field name="datasourceid" readonly="1"/>
            </group><field name="user_ids" widget="many2many_tags" invisible="1"/></sheet></form>
        </field>
    </record>
    <record id="action_daily_sales_branch" model="ir.actions.act_window">
        <field name="name">شعبات</field><field name="res_model">daily.sales.branch</field><field name="view_mode">list,form</field>
    </record>
</odoo>

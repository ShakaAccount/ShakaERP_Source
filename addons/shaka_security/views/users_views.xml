<odoo>
    <record id="view_users_form_shaka_security_access" model="ir.ui.view">
        <field name="name">res.users.shaka.security.access.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="دسترسی فرم‌ها" groups="base.group_system">
                    <div class="alert alert-info" role="alert">برای تنظیم مراحل گردش‌کار، روی سطر فرم دوبارکلیک کنید.</div>
                    <button name="action_prepare_shaka_access" type="object" string="بارگذاری فرم‌های موجود" class="btn-secondary"/>
                    <field name="shaka_form_access_ids" nolabel="1">
                        <list open_form_view="1" create="0" delete="0">
                            <field name="form_id" string="نام فرم" readonly="1"/>
                            <field name="can_read" string="نمایش" widget="boolean_toggle"/>
                            <field name="can_create" string="ایجاد" widget="boolean_toggle"/>
                            <field name="can_write" string="ویرایش" widget="boolean_toggle"/>
                            <field name="can_unlink" string="حذف" widget="boolean_toggle"/>
                        </list>
                        <form string="تنظیم دسترسی فرم"><sheet>
                            <field name="has_workflow" invisible="1"/>
                            <div class="oe_title"><h1><field name="form_id" readonly="1"/></h1></div>
                            <div class="alert alert-success" role="alert" invisible="not has_workflow">این فرم گردش‌کار دارد؛ دسترسی فقط از مراحل زیر کنترل می‌شود.</div>
                            <group string="دسترسی کلی فرم" col="4" invisible="has_workflow">
                                <field name="can_read" string="نمایش" widget="boolean_toggle"/>
                                <field name="can_create" string="ایجاد" widget="boolean_toggle"/>
                                <field name="can_write" string="ویرایش" widget="boolean_toggle"/>
                                <field name="can_unlink" string="حذف" widget="boolean_toggle"/>
                            </group>
                            <separator string="دسترسی مرحله‌های گردش‌کار" invisible="not has_workflow"/>
                            <field name="workflow_access_ids" nolabel="1" invisible="not has_workflow">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="stage_id" string="مرحله" readonly="1"/>
                                    <field name="can_read" string="نمایش" widget="boolean_toggle"/>
                                    <field name="can_create" string="ایجاد" widget="boolean_toggle"/>
                                    <field name="can_write" string="ویرایش" widget="boolean_toggle"/>
                                    <field name="can_unlink" string="حذف" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </sheet></form>
                    </field>
                </page>
                <page string="دسترسی شعب" groups="base.group_system">
                    <div class="alert alert-warning" role="alert">اگر هیچ شعبه‌ای انتخاب نشود، کاربر به همه شعب دسترسی دارد.</div>
                    <field name="shaka_branch_access_ids" nolabel="1"><list editable="bottom"><field name="branch_id" string="شعبه"/></list></field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_dim_company_form" model="ir.ui.view">
        <field name="name">dim.company.form</field>
        <field name="model">dim.company</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="companyid"/>
                            <field name="parentid"/>
                            <field name="companytitle"/>
                            <field name="entitle"/>
                        </group>
                        <group>
                            <field name="level0"/>
                            <field name="level1"/>
                            <field name="level2"/>
                            <field name="level3"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dim_company_list" model="ir.ui.view">
        <field name="name">dim.company.list</field>
        <field name="model">dim.company</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" duplicate="false">
                <field name="companyid"/>
                <field name="companytitle"/>
                <field name="entitle"/>
                <field name="level0"/>
                <field name="level1"/>
            </list>
        </field>
    </record>

    <record id="action_dim_company" model="ir.actions.act_window">
        <field name="name">Company Dimension</field>
        <field name="res_model">dim.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dim_company_root" name="BI Dimensions" sequence="100"/>
    <menuitem id="menu_dim_company"
              name="Company Dimension"
              action="action_dim_company"
              parent="menu_dim_company_root"/>
</odoo>
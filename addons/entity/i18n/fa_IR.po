#. module: entity
#. odoo-python
#: code:addons/entity/models/ddl_builder.py:0
msgid ""
"Column '%(c)s' of entity '%(e)s' references entity '%(r)s', but its table "
"%(d)s.%(s)s.%(t)s does not exist on the DW server. Open '%(r)s' and click "
"'Sync DW Table' first."
msgstr ""
"ستون '%(c)s' از موجودیت '%(e)s' به موجودیت '%(r)s' ارجاع می‌دهد، اما جدول "
"%(d)s.%(s)s.%(t)s آن در سرور انبار داده وجود ندارد. ابتدا '%(r)s' را باز "
"کرده و روی 'همگام‌سازی جدول انبار داده' کلیک کنید."

#. module: entity
#. odoo-python
#: code:addons/entity/models/ddl_builder.py:0
msgid ""
"Column '%(c)s' of entity '%(e)s' references entity '%(r)s', but its table "
"%(d)s.%(s)s.%(t)s has no PRIMARY KEY constraint matching column '%(p)s'. "
"Open '%(r)s' and click 'Sync DW Table' to rebuild the constraint, then save "
"this column again."
msgstr ""
"ستون '%(c)s' از موجودیت '%(e)s' به موجودیت '%(r)s' ارجاع می‌دهد، اما جدول "
"%(d)s.%(s)s.%(t)s آن هیچ محدودیت کلید اصلی (PRIMARY KEY) منطبق با ستون "
"'%(p)s' ندارد. '%(r)s' را باز کرده و روی 'همگام‌سازی جدول انبار داده' کلیک "
"کنید تا محدودیت بازسازی شود، سپس این ستون را دوباره ذخیره کنید."

#. module: entity
#. odoo-python
#: code:addons/entity/models/ddl_builder.py:0
msgid ""
"Column '%(c)s' of entity '%(e)s' references entity '%(r)s', but that entity "
"has no Schema or Name set. Fill them in before saving this column."
msgstr ""
"ستون '%(c)s' از موجودیت '%(e)s' به موجودیت '%(r)s' ارجاع می‌دهد، اما آن "
"موجودیت فاقد شما یا نام تنظیم‌شده است. پیش از ذخیره این ستون آن‌ها را "
"تکمیل کنید."

#. module: entity
#. odoo-python
#: code:addons/entity/models/ddl_builder.py:0
msgid ""
"Column '%(c)s' of entity '%(e)s' references entity '%(r)s', but that entity "
"has no column marked as Primary Key. Mark exactly one column of '%(r)s' as "
"Primary Key, then save again."
msgstr ""
"ستون '%(c)s' از موجودیت '%(e)s' به موجودیت '%(r)s' ارجاع می‌دهد، اما آن "
"موجودیت هیچ ستونی به‌عنوان کلید اصلی مشخص‌شده ندارد. دقیقاً یک ستون از "
"'%(r)s' را به‌عنوان کلید اصلی علامت‌گذاری کرده، سپس دوباره ذخیره کنید."


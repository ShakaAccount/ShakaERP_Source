<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_raes_gnr_module_list" model="ir.ui.view">
        <field name="name">raes.gnr.module.list</field>
        <field name="model">raes.gnr.module</field>
        <field name="arch" type="xml">
            <list string="Modules">
                <field name="id"/>
                <field name="title"/>
                <field name="priority"/>
                <field name="is_user_defined"/>
                <field name="entity_count"/>
                <field name="creation_date"/>
                <field name="modification_date"/>
            </list>
        </field>
    </record>

    <record id="view_raes_gnr_module_form" model="ir.ui.view">
        <field name="name">raes.gnr.module.form</field>
        <field name="model">raes.gnr.module</field>
        <field name="arch" type="xml">
            <form string="Module">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_entities" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="entity_count" widget="statinfo"
                                   string="Entities"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Title"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="id"/>
                            <field name="priority"/>
                            <field name="is_user_defined"/>
                        </group>
                        <group string="Audit">
                            <field name="creator_user_id"/>
                            <field name="creation_date"/>
                            <field name="editor_user_id"/>
                            <field name="modification_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entities">
                            <field name="entity_ids">
                                <list>
                                    <field name="id"/>
                                    <field name="schema_name"/>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_raes_gnr_module_search" model="ir.ui.view">
        <field name="name">raes.gnr.module.search</field>
        <field name="model">raes.gnr.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <filter name="filter_user_defined" string="User Defined"
                        domain="[('is_user_defined','=',True)]"/>
                <filter name="filter_system" string="System"
                        domain="[('is_user_defined','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_raes_gnr_module" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="res_model">raes.gnr.module</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
<odoo>
    <record id="privilege_payment_request" model="res.groups.privilege">
        <field name="name">درخواست پرداخت</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_accountant" model="res.groups">
        <field name="name">حسابدار</field>
        <field name="privilege_id" ref="privilege_payment_request"/>
        <field name="comment">Accepts requests after unit manager. Does NOT edit مرحله پرداخت.</field>
    </record>

    <record id="group_tax" model="res.groups">
        <field name="name">مالیات</field>
        <field name="privilege_id" ref="privilege_payment_request"/>
        <field name="comment">Fills مرحله پرداخت stages, then sends to accounting management.</field>
    </record>

    <record id="group_acc_mgmt" model="res.groups">
        <field name="name">مدیر حسابداری</field>
        <field name="privilege_id" ref="privilege_payment_request"/>
        <field name="comment">Accepts after tax group; sends to treasurer.</field>
    </record>

    <record id="group_treasurer" model="res.groups">
        <field name="name">خزانه دار</field>
        <field name="privilege_id" ref="privilege_payment_request"/>
        <field name="comment">Records payments (مبلغ پرداخت شده/شماره پیگیری/شماره چک/شماره اعلامیه پرداخت/توضیحات).</field>
    </record>

    <record id="group_unit_manager" model="res.groups">
        <field name="name">مدیر واحد</field>
        <field name="privilege_id" ref="privilege_payment_request"/>
        <field name="comment">Accepts/rejects payment requests submitted to him. Cannot see مرحله پرداخت.</field>
    </record>

    <!-- READ: group rules OR together. Plain users get own-records only;
         each elevated group additionally gets read-all, so its members see
         every request's progress. -->
    <record id="rule_payment_request_read_own" model="ir.rule">
        <field name="name">Payment Request: read own records</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_read_all_unit" model="ir.rule">
        <field name="name">Payment Request: unit manager reads all</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_unit_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_read_all_accountant" model="ir.rule">
        <field name="name">Payment Request: accountant reads all</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_read_all_tax" model="ir.rule">
        <field name="name">Payment Request: tax group reads all</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_tax'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_read_all_acc_mgmt" model="ir.rule">
        <field name="name">Payment Request: accounting mgmt reads all</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_acc_mgmt'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_read_all_treasurer" model="ir.rule">
        <field name="name">Payment Request: treasurer reads all</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_treasurer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <!-- WRITE: creator edits own while draft; can also delete own drafts -->
    <record id="rule_payment_request_own_write" model="ir.rule">
        <field name="name">Payment Request: own records editable in draft</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <!-- WRITE: each workflow group only on requests sitting in its turn.
         Buttons + view-level readonly gate what they may change. -->
    <record id="rule_payment_request_unit_manager_write" model="ir.rule">
        <field name="name">Payment Request: unit manager acts on pending assigned</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_unit_manager'))]"/>
        <field name="domain_force">[('state', '=', 'unit_review'), ('unit_manager_id', '=', user.id)]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_accountant_write" model="ir.rule">
        <field name="name">Payment Request: accountant acts on pending review</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_accountant'))]"/>
        <field name="domain_force">[('state', '=', 'accountant_review')]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_tax_write" model="ir.rule">
        <field name="name">Payment Request: tax group acts on tax_review</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_tax'))]"/>
        <field name="domain_force">[('state', '=', 'tax_review')]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_acc_mgmt_write" model="ir.rule">
        <field name="name">Payment Request: accounting mgmt acts on acc_mgmt_review</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_acc_mgmt'))]"/>
        <field name="domain_force">[('state', '=', 'acc_mgmt_review')]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_payment_request_treasurer_write" model="ir.rule">
        <field name="name">Payment Request: treasurer acts on treasury</field>
        <field name="model_id" ref="model_payment_request_payment_request"/>
        <field name="groups" eval="[(4, ref('group_treasurer'))]"/>
        <field name="domain_force">[('state', '=', 'treasury')]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>

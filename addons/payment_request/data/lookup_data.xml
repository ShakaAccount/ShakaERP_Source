<odoo>
    <data noupdate="1">
        <record id="seq_payment_request" model="ir.sequence">
            <field name="name">Payment Request</field>
            <field name="code">payment_request.sequence</field>
            <field name="prefix">PR-</field>
            <field name="padding">4</field>
        </record>
    </data>

    <record id="lookup_type_payment_reason" model="lookup.type">
        <field name="name">بابت پرداخت</field>
        <field name="code">payment_reason</field>
    </record>

    <record id="lookup_type_payment_type" model="lookup.type">
        <field name="name">نوع پرداخت</field>
        <field name="code">payment_type</field>
    </record>
</odoo>

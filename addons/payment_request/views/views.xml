<odoo>
    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">payment.request.list</field>
        <field name="model">payment_request.payment_request</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="date"/>
                <field name="unit_id"/>
                <field name="party_id"/>
                <field name="reason_id"/>
                <field name="formality"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'unit_review'"
                       decoration-warning="state == 'accounting'"
                       decoration-success="state in ('accounting_approved', 'paid')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">payment.request.form</field>
        <field name="model">payment_request.payment_request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="ارسال برای تایید"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manager_accept" type="object" string="تایید مدیر"
                            class="btn-primary" invisible="state != 'unit_review'"
                            groups="payment_request.group_unit_manager"/>
                    <button name="action_manager_reject" type="object" string="رد"
                            invisible="state != 'unit_review'"
                            groups="payment_request.group_unit_manager"/>
                    <button name="action_accountant_accept" type="object" string="تایید حسابداری"
                            class="btn-primary" invisible="state != 'accounting'"
                            groups="payment_request.group_accountant"/>
                    <button name="action_accountant_mark_paid" type="object" string="پرداخت شد"
                            invisible="state != 'accounting_approved'"
                            groups="payment_request.group_accountant"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,unit_review,accounting,accounting_approved,paid"/>
                </header>
                <sheet>
                    <field name="is_accountant" invisible="1"/>
                    <field name="is_unit_manager" invisible="1"/>
                    <field name="is_site_admin" invisible="1"/>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="date"/>
                            <field name="formality"/>
                            <field name="unit_manager_id" invisible="state != 'draft' and not is_accountant and not is_site_admin"/>
                        </group>
                        <group>
                            <field name="unit_id"/>
                            <field name="party_id"/>
                            <field name="reason_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="جزئیات درخواست پرداخت">
                            <field name="detail_ids">
                                <list editable="bottom">
                                    <field name="line_no" string="#" readonly="1"/>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="paytype_id"/>
                                    <field name="costcenter_id"/>
                                    <field name="amount" sum="جمع"/>
                                    <field name="vat" sum="جمع"/>
                                    <field name="net_amount" sum="جمع"/>
                                    <field name="agreed_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="اطلاعات تکمیلی">
                            <field name="extra_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="اطلاعات پرداخت شده">
                            <field name="paid_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date"/>
                                    <field name="amount" sum="جمع"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="مرحله پرداخت" invisible="is_unit_manager and not is_accountant">
                            <field name="stage_ids" readonly="not is_accountant">
                                <list editable="bottom" create="0" delete="0" no_open="1">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="state" decoration-danger="state == 'failed'" decoration-success="state == 'checked'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payment_request" model="ir.actions.act_window">
        <field name="name">درخواست پرداخت</field>
        <field name="res_model">payment_request.payment_request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_payment_request_root" name="درخواست پرداخت" sequence="140"/>
    <menuitem id="menu_payment_request" name="درخواست‌ها" action="action_payment_request" parent="menu_payment_request_root"/>
</odoo>

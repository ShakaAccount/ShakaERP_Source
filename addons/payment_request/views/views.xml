<odoo>
    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">payment.request.list</field>
        <field name="model">payment_request.payment_request</field>
        <field name="arch" type="xml">
            <list>
                <field name="number" optional="hide"/>
                <field name="date" optional="hide"/>
                <field name="unit_id" optional="hide"/>
                <field name="party_id" optional="hide"/>
                <field name="reason_id" optional="hide"/>
                <field name="formality" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('unit_review', 'accountant_review', 'tax_review', 'acc_mgmt_review')"
                       decoration-warning="state == 'treasury'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">payment.request.form</field>
        <field name="model">payment_request.payment_request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="ارسال برای تایید"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manager_accept" type="object" string="تایید مدیر"
                            class="btn-primary" invisible="state != 'unit_review'"
                            groups="payment_request.group_unit_manager"/>
                    <button name="action_manager_reject" type="object" string="رد"
                            invisible="state != 'unit_review'"
                            groups="payment_request.group_unit_manager"/>
                    <button name="action_accountant_accept" type="object" string="تایید حسابدار"
                            class="btn-primary" invisible="state != 'accountant_review'"
                            groups="payment_request.group_accountant"/>
                    <button name="action_tax_stages_done" type="object" string="مراحل تکمیل شد؛ ارسال به مدیر حسابداری"
                            class="btn-primary" invisible="state != 'tax_review'"
                            groups="payment_request.group_tax"/>
                    <button name="action_acc_mgmt_accept" type="object" string="تایید مدیر حسابداری"
                            class="btn-primary" invisible="state != 'acc_mgmt_review'"
                            groups="payment_request.group_acc_mgmt"/>
                    <button name="action_treasurer_paid" type="object" string="ثبت نهایی پرداخت"
                            class="btn-primary" invisible="state != 'treasury'"
                            groups="payment_request.group_treasurer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,unit_review,accountant_review,tax_review,acc_mgmt_review,treasury,paid"/>
                </header>
                <sheet>
                    <field name="is_accountant" invisible="1"/>
                    <field name="is_unit_manager" invisible="1"/>
                    <field name="is_tax" invisible="1"/>
                    <field name="is_acc_mgmt" invisible="1"/>
                    <field name="is_treasurer" invisible="1"/>
                    <field name="is_site_admin" invisible="1"/>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="date"/>
                            <field name="formality"/>
                            <field name="unit_manager_id" invisible="state != 'draft' and not is_accountant and not is_site_admin"/>
                        </group>
                        <group>
                            <field name="unit_id"/>
                            <field name="party_id"/>
                            <field name="reason_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="جزئیات درخواست پرداخت">
                            <field name="detail_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="line_no" string="#" readonly="1"/>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="paytype_id"/>
                                    <field name="costcenter_id"/>
                                    <field name="amount" sum="جمع"/>
                                    <field name="vat" sum="جمع"/>
                                    <field name="net_amount" sum="جمع"/>
                                    <field name="agreed_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="اطلاعات تکمیلی">
                            <field name="extra_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="account_no"/>
                                    <field name="party_name"/>
                                    <field name="sheba_no"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="مرحله پرداخت" invisible="is_unit_manager and not is_tax and not is_site_admin">
                            <field name="stage_ids" readonly="not (is_tax or is_site_admin)">
                                <list create="0" delete="0" no_open="1"
                                      decoration-muted="state == 'failed' and not is_frontier"
                                      decoration-success="state == 'checked'">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="is_frontier" column_invisible="1"/>
                                    <field name="allow_reject" column_invisible="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="state" readonly="1"
                                           decoration-danger="state == 'failed'" decoration-success="state == 'checked'"/>
                                    <button name="action_accept" type="object" string="تایید"
                                            icon="fa-check" invisible="state != 'unattended' or not is_frontier"
                                            class="btn-success"/>
                                    <button name="action_reject" type="object" string="رد"
                                            icon="fa-times" invisible="state != 'unattended' or not is_frontier or not allow_reject"
                                            class="btn-danger"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                آبشاری: فقط مرحله جاری قابل تایید/رد است؛ مراحل بعدی خودکار رد شده‌اند
                                و با پیشرفت آبشار آزاد می‌شوند. رد کردن هر مرحله = رد کل درخواست.
                            </div>
                        </page>
                        <page string="اطلاعات پرداخت شده">
                            <field name="paid_ids" readonly="not (is_treasurer or is_site_admin) or state != 'treasury'">
                                <list editable="bottom">
                                    <field name="paid_amount" sum="جمع"/>
                                    <field name="tracking_no"/>
                                    <field name="cheque_no"/>
                                    <field name="payment_declaration_no"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payment_request" model="ir.actions.act_window">
        <field name="name">درخواست پرداخت</field>
        <field name="res_model">payment_request.payment_request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_payment_request_root" name="درخواست پرداخت" sequence="140"/>
    <menuitem id="menu_payment_request" name="درخواست‌ها" action="action_payment_request" parent="menu_payment_request_root"/>
</odoo>

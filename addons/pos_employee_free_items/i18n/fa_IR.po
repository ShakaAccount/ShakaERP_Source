#. module: pos_employee_free_items
#: model:ir.model.constraint,message:pos_employee_free_items.constraint_pos_free_item_catalog_product_id_company_id_uniq
msgid "A product can appear only once in the free-item catalogue per company."
msgstr "هر محصول تنها یک‌بار می‌تواند در فهرست اقلام رایگان هر شرکت ظاهر شود."

#. module: pos_employee_free_items

msgstr "یک صندوق‌دار انتخاب کنید"

#. module: pos_employee_free_items
#: code:addons/pos_employee_free_items/static/src/js/pos_free_items.js:0
msgid "Select an employee cashier before claiming a free item."
msgstr "قبل از دریافت قلم رایگان، یک صندوق‌دار کارمند انتخاب کنید."

#. module: pos_employee_free_items
#: code:addons/pos_employee_free_items/controllers/totp_enroll.py:0
msgid "The allowance was approved, but Odoo could not add the item to this order."
msgstr "سهمیه تأیید شد، اما اودو نتوانست قلم را به این سفارش اضافه کند."

#. module: pos_employee_free_items
#: code:addons/pos_employee_free_items/controllers/totp_enroll.py:0
msgid "The cashier must be linked to an Odoo user with two-factor authentication enabled."
msgstr "صندوق‌دار باید به یک کاربر اودو با احراز هویت دو مرحله‌ای فعال متصل باشد."

#. module: pos_employee_free_items
#: code:addons/pos_employee_free_items/controllers/totp_enroll.py:0
msgid "The POS configuration could not be found."
msgstr "تنظیمات صندوق پیدا نشد."

#. module: pos_employee_free_items
#: code:addons/pos_employee_free_items/controllers/totp_enroll.py:0

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The old custom enrolment action has been removed.  Odoo's auth_totp
         module owns TOTP setup, so users configure it from their own profile. -->
    <record id="view_users_form_inherit_totp" model="ir.ui.view">
        <field name="name">res.users.form.inherit.totp</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <div class="mt-2">
                    <span class="text-muted" groups="pos_employee_free_items.group_pos_free_item_user">
                        <i class="fa fa-shield"/> Configure two-factor authentication from your user profile before claiming POS free items.
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

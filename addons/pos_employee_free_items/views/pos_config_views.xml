<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_free_limit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.free.limit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']" position="inside">
                <group string="POS Free Items">
                    <field name="free_item_daily_limit"
                           groups="pos_employee_free_items.group_pos_free_item_manager"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pos_config_form_inherit_free_limit" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.free.limit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_settings_container'][last()]" position="after">
                <div class="row mt16 o_settings_container" groups="pos_employee_free_items.group_pos_free_item_manager">
                    <setting string="Employee Free Items">
                        <field name="free_item_daily_limit"/>
                        <div class="content-group">
                            <p class="text-muted">Maximum number of free items an employee can claim per day (default 2).</p>
                        </div>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
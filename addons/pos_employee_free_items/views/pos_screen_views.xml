<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend the POS ProductScreen Owl template to inject the Free Item List -->
        <template id="ProductScreen_free_items_extension" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" name="ProductScreen with Free Items">
            <xpath expr="//div[contains(@class, 'product-screen')]" position="inside">
                <div class="free-item-section mb-3">
                    <h5 class="text-muted mb-2">Free Items (Employee)</h5>
                    <FreeItemList/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
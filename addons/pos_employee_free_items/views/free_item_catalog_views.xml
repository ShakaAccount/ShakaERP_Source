<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_free_item_catalog_tree" model="ir.ui.view">
        <field name="name">pos.free.item.catalog.tree</field>
        <field name="model">pos.free.item.catalog</field>
        <field name="arch" type="xml">
            <list string="Free-Item Catalogue" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pos_free_item_catalog_form" model="ir.ui.view">
        <field name="name">pos.free.item.catalog.form</field>
        <field name="model">pos.free.item.catalog</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_free_item_catalog" model="ir.actions.act_window">
        <field name="name">Free-Item Catalogue</field>
        <field name="res_model">pos.free.item.catalog</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_pos_free_item_catalog"
              name="Free-Item Catalogue"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_free_item_catalog"
              groups="pos_employee_free_items.group_pos_free_item_manager"
              sequence="30"/>

    <!-- POS QWeb Templates -->
    <template id="FreeItemButton" name="Free Item Button">
        <button t-att-class="'btn btn-secondary btn-sm' + (props.product ? '' : ' d-none')"
                t-on-click="onClick">
            <i class="fa fa-gift"/> <t t-esc="props.product.display_name"/>
        </button>
    </template>

    <template id="FreeItemList" name="Free Item List">
        <div class="d-flex flex-wrap gap-2 mt-2">
            <t t-foreach="state.catalog" t-as="item">
                <FreeItemButton t-key="item.id" t-props="item"/>
            </t>
        </div>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_free" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.free</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='products']" position="after">
                <page string="Free Items" name="free_items">
                    <field name="free_item_line_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="is_free_item"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Free Item List Component Template -->
    <t t-name="pos_employee_free_items.FreeItemList">
        <div class="free-item-list">
            <div t-if="!hasEmployeeMode" class="alert alert-warning m-2">
                Enable <strong>Employees</strong> in the POS configuration to use free items.
            </div>
            <div t-elif="!catalogItems.length" class="text-muted p-2">
                No free items are configured.
            </div>
            <t t-foreach="catalogItems" t-as="item" t-key="item.id">
                <div class="free-item-option d-flex align-items-center gap-2 w-100 p-2 mb-1 border rounded bg-light">
                    <i class="fa fa-gift me-2 text-secondary"/>
                    <span class="flex-grow-1" t-esc="item.product_id.display_name || item.product_id.name || item.product_id"/>
                    <div class="input-group input-group-sm" style="width: 100px;">
                        <button type="button" class="btn btn-outline-secondary" 
                                t-att-disabled="state.isClaiming || getQuantity(item) <= 1"
                                t-on-click="() => setQuantity(item, getQuantity(item) - 1)">
                            <i class="fa fa-minus"/>
                        </button>
                        <input type="text" class="form-control text-center" 
                               t-att-value="getQuantity(item)"
                               t-att-disabled="state.isClaiming"
                               t-on-change="() => setQuantity(item, $event.target.value)"/>
                        <button type="button" class="btn btn-outline-secondary" 
                                t-att-disabled="state.isClaiming"
                                t-on-click="() => setQuantity(item, getQuantity(item) + 1)">
                            <i class="fa fa-plus"/>
                        </button>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm"
                            t-att-disabled="state.isClaiming"
                            t-on-click="() => this.onSelectFreeItem(item)">
                        <t t-esc="_t('Claim')"/>
                    </button>
                </div>
            </t>
        </div>
    </t>

    <!-- Extend the POS ProductScreen Owl template to inject the Free Item List -->
    <t t-name="pos_employee_free_items.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'product-screen')]" position="inside">
            <div class="free-item-section mb-3">
                <h5 class="text-muted mb-2">Free Items (Employee)</h5>
                <FreeItemList/>
            </div>
        </xpath>
    </t>

</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Free Item List Component Template -->
    <t t-name="pos_employee_free_items.FreeItemList">
        <div class="free-item-list">
            <div t-if="state.loading" class="text-muted p-2">
                Loading free items...
            </div>
            <t t-foreach="state.catalog" t-as="item" t-key="item.id">
                <button type="button" class="free-item-option btn btn-outline-secondary w-100 text-start p-2 mb-1"
                        t-on-click="() => this.onSelectFreeItem(item)">
                    <t t-esc="item.product_id[1]"/>
                </button>
            </t>
        </div>
    </t>

    <!-- Extend the POS ProductScreen Owl template to inject the Free Item List -->
    <t t-name="pos_employee_free_items.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'product-screen')]" position="inside">
            <div class="free-item-section mb-3">
                <h5 class="text-muted mb-2">Free Items (Employee)</h5>
                <FreeItemList/>
            </div>
        </xpath>
    </t>

</templates>

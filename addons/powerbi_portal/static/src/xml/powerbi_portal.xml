<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="powerbi_portal.Portal">
        <div t-attf-class="o_powerbi_portal {{ state.sidebarCollapsed ? 'o_powerbi_sidebar_collapsed' : '' }}">
            <div class="o_powerbi_sidebar">
                <div class="o_powerbi_sidebar_header">
                    <span class="o_powerbi_sidebar_title">Power BI Reports</span>
                    <button type="button"
                            class="btn o_powerbi_sidebar_toggle"
                            t-on-click="toggleSidebar"
                            t-att-title="state.sidebarCollapsed ? 'Expand' : 'Collapse'">
                        <i t-attf-class="fa {{ state.sidebarCollapsed ? 'fa-angle-double-right' : 'fa-angle-double-left' }}"/>
                    </button>
                </div>

                <div t-if="state.loading" class="o_powerbi_status">Loading reports...</div>
                <div t-elif="state.error" class="o_powerbi_status text-danger" t-esc="state.error"/>
                <div t-elif="!state.roots.length" class="o_powerbi_status">No reports are available to you yet.</div>
                <div t-else="" class="o_powerbi_tree">
                    <t t-foreach="state.roots" t-as="node" t-key="node.id">
                        <TreeNode
                                node="node"
                                children="getChildren(node)"
                                selectedId="selectedId"
                                expandedIds="state.open"
                                closingIds="state.closing"
                                onToggle="toggleFolder"
                                onSelect="onSelect"
                                getChildren="getChildren"
                                level="0"
                                index="node_index">
                            <t t-set-slot="icon" t-slot-scope="ctx">
                                <i t-attf-class="fa {{ ctx.node.children ? 'fa-folder-o' : 'fa-bar-chart' }} o_powerbi_icon"/>
                            </t>
                        </TreeNode>
                    </t>
                </div>
            </div>

            <div class="o_powerbi_main">
                <iframe t-if="state.selectedReport?.url"
                        t-att-src="state.selectedReport.url"
                        class="o_powerbi_iframe"
                        t-att-title="state.selectedReport.name"
                        referrerpolicy="no-referrer"
                        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads"/>
                <div t-else="" class="o_powerbi_placeholder">Select a report from the list.</div>
            </div>
        </div>
    </t>

</templates>

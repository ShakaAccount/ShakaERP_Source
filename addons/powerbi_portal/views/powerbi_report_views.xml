<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_powerbi_report_list" model="ir.ui.view">
        <field name="name">powerbi.report.list</field>
        <field name="model">powerbi.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="folder"/>
                <field name="allowed_group_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_powerbi_report_form" model="ir.ui.view">
        <field name="name">powerbi.report.form</field>
        <field name="model">powerbi.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Dashboard"/></h1>
                    </div>
                    <group>
                        <field name="url" placeholder="https://pbirs.company.local/reports/powerbi/..."/>
                        <field name="folder" placeholder="e.g. Finance"/>
                        <field name="catalog_path"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Visibility" name="visibility_group">
                        <field name="allowed_group_ids" widget="many2many_tags"
                               placeholder="Leave empty to show to everyone"/>
                        <field name="allowed_user_ids" widget="many2many_tags"
                               placeholder="Individual users, in addition to the groups above"/>
                        <div class="text-muted" colspan="2" invisible="not catalog_path">
                            Saving this report (including autosave) automatically pushes
                            the groups/users above to PBIRS as Browser access - see
                            Last Push below for the outcome of the most recent save.
                        </div>
                    </group>
                    <group>
                        <field name="description" placeholder="Optional notes"/>
                    </group>
                    <group string="Last Push to PBIRS" invisible="not last_push_date">
                        <field name="last_push_date" readonly="1"/>
                        <field name="last_push_summary" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_powerbi_report_admin" model="ir.actions.act_window">
        <field name="name">Manage Reports</field>
        <field name="res_model">powerbi.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- The actual portal client action (sidebar + iframe) -->
    <record id="action_powerbi_portal" model="ir.actions.client">
        <field name="name">Power BI</field>
        <field name="tag">powerbi_portal.portal</field>
    </record>

    <menuitem id="menu_powerbi_portal_root" name="Power BI" sequence="90"
              web_icon="powerbi_portal,static/description/icon.png"
              action="action_powerbi_portal"/>
    <menuitem id="menu_powerbi_portal_manage" name="Manage Reports"
              parent="menu_powerbi_portal_root"
              action="action_powerbi_report_admin"
              sequence="100"
              groups="base.group_system"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Connection settings -->
    <record id="view_ad_group_sync_config_form" model="ir.ui.view">
        <field name="name">ad.group.sync.config.form</field>
        <field name="model">ad.group.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import_from_odoo_ldap" type="object"
                            string="Import from Odoo LDAP Config" class="btn-secondary"/>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="server"/>
                        <field name="port"/>
                        <field name="use_tls"/>
                        <field name="base_dn"/>
                        <field name="binddn"/>
                        <field name="bind_password" password="True"/>
                        <field name="netbios_domain" placeholder="e.g. SHAKA (auto-derived from Base DN if left blank)"/>
                        <field name="active"/>
                    </group>
                    <group string="AD Group Auto-Creation (used by PBIRS Access Push)">
                        <field name="group_creation_base_dn" placeholder="OU=PowerBI Groups,OU=Groups,DC=shaka,DC=local"/>
                        <field name="group_creation_prefix"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ad_group_sync_config_list" model="ir.ui.view">
        <field name="name">ad.group.sync.config.list</field>
        <field name="model">ad.group.sync.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="server"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ad_group_sync_config" model="ir.actions.act_window">
        <field name="name">AD Connection Settings</field>
        <field name="res_model">ad.group.sync.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Mappings -->
    <record id="view_ad_group_mapping_form" model="ir.ui.view">
        <field name="name">ad.group.mapping.form</field>
        <field name="model">ad.group.mapping</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_now" type="object"
                            string="Sync Now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="owner != 'odoo'">
                        This AD group is Odoo-owned - it was auto-created by
                        PBIRS Portal's access-push feature purely to give
                        PBIRS a real AD principal. The pull sync/cron
                        deliberately skips it. Manage membership on the Odoo
                        group itself, then save the related report (access
                        push happens automatically on save) to update AD/PBIRS.
                    </div>
                    <group>
                        <field name="ad_group_dn"/>
                        <field name="odoo_group_id"/>
                        <field name="owner"/>
                        <field name="active"/>
                    </group>
                    <group string="Last Sync">
                        <field name="last_sync_date"/>
                        <field name="last_sync_summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ad_group_mapping_list" model="ir.ui.view">
        <field name="name">ad.group.mapping.list</field>
        <field name="model">ad.group.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="ad_group_dn"/>
                <field name="odoo_group_id"/>
                <field name="owner"/>
                <field name="last_sync_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ad_group_mapping" model="ir.actions.act_window">
        <field name="name">AD Group Mappings</field>
        <field name="res_model">ad.group.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ad_group_sync_root" name="AD Group Sync"
              parent="menu_powerbi_portal_root" sequence="120"/>
    <menuitem id="menu_ad_group_mapping" name="Group Mappings"
              parent="menu_ad_group_sync_root" action="action_ad_group_mapping" sequence="10"/>
    <menuitem id="menu_ad_group_sync_config" name="Connection Settings"
              parent="menu_ad_group_sync_root" action="action_ad_group_sync_config" sequence="20"/>

</odoo>

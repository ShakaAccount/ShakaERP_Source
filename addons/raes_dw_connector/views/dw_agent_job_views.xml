<odoo>
    <record id="view_raes_dw_agent_job_form" model="ir.ui.view">
        <field name="name">raes.dw.agent.job.form</field>
        <field name="model">raes.dw.agent.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load" type="object"
                            string="Load from SQL Server" class="btn-secondary"/>
                    <button name="action_apply" type="object"
                            string="Apply to SQL Server" class="btn-primary"/>
                    <button name="action_run_now" type="object"
                            string="Run now" class="btn-secondary"
                            invisible="not job_exists"
                            confirm="Start the job on SQL Server now?"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"
                         invisible="job_exists">
                        This job isn't on SQL Server yet (or hasn't been
                        loaded). Apply will create it.
                    </div>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="job_name"/>
                        </group>
                        <group>
                            <field name="job_exists"/>
                            <field name="last_sync"/>
                            <field name="last_run_outcome"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Steps">
                            <field name="step_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="step_type"/>
                                    <field name="command_preview"
                                           string="Command" optional="hide"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="step_type" widget="radio"
                                                       options="{'horizontal': true}"/>
                                            </group>
                                        </group>
                                        <div invisible="step_type != 'etl'">
                                            <group>
                                                <group>
                                                    <field name="database"
                                                           placeholder="connection database"/>
                                                    <field name="procedure"
                                                           required="step_type == 'etl'"/>
                                                </group>
                                                <group>
                                                    <button name="action_fetch_params"
                                                            type="object" string="Fetch parameters"
                                                            class="btn-secondary"
                                                            help="Read the parameter list from the procedure on SQL Server."/>
                                                </group>
                                            </group>
                                            <field name="param_ids">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                    <field name="sql_type"/>
                                                    <field name="value" placeholder="NULL"/>
                                                </list>
                                            </field>
                                        </div>
                                        <group invisible="step_type != 'custom'">
                                            <group>
                                                <field name="subsystem"
                                                       required="step_type == 'custom'"/>
                                                <field name="database"
                                                       placeholder="connection database"
                                                       invisible="subsystem != 'TSQL'"/>
                                                <field name="server"
                                                       placeholder="same as DW connection host"
                                                       invisible="subsystem not in ('ANALYSISQUERY', 'ANALYSISCOMMAND')"/>
                                            </group>
                                        </group>
                                        <div dir="ltr" invisible="step_type != 'custom'">
                                            <field name="command" class="font-monospace w-100"
                                                   required="step_type == 'custom'"
                                                   placeholder="Command, sent to SQL Agent as typed"/>
                                        </div>
                                        <group invisible="step_type != 'ssas'">
                                            <group>
                                                <field name="ssas_server"
                                                       placeholder="same as DW connection host"/>
                                                <field name="ssas_database"
                                                       required="step_type == 'ssas'"/>
                                                <field name="ssas_refresh_type"/>
                                            </group>
                                        </group>
                                        <div invisible="step_type == 'custom'">
                                            <separator string="Job step command"/>
                                            <div dir="ltr">
                                                <field name="command_preview"
                                                       class="font-monospace w-100"/>
                                            </div>
                                        </div>
                                    </sheet>
                                </form>
                            </field>
                            <div class="text-muted">
                                Steps run top to bottom — drag to reorder. When
                                a step fails the job stops, so later steps
                                never run on bad data.
                            </div>
                        </page>
                        <page string="Schedule">
                            <group>
                                <group>
                                    <field name="schedule_name"/>
                                    <field name="schedule_type"
                                           widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="schedule_enabled"/>
                                </group>
                            </group>
                            <group string="One-time occurrence"
                                   invisible="schedule_type != 'one_time'">
                                <field name="start_date" string="Date"/>
                                <field name="start_time" string="Time"
                                       widget="float_time"/>
                            </group>
                            <div invisible="schedule_type != 'recurring'">
                                <group string="Frequency">
                                    <group>
                                        <field name="occurs"/>
                                        <field name="recurs_every"
                                               string="Recurs every (days)"
                                               invisible="occurs != 'daily'"/>
                                        <field name="recurs_every"
                                               string="Recurs every (weeks)"
                                               invisible="occurs != 'weekly'"/>
                                        <field name="recurs_every"
                                               string="Every (months)"
                                               invisible="occurs != 'monthly'"/>
                                        <field name="monthly_mode"
                                               widget="radio"
                                               invisible="occurs != 'monthly'"/>
                                        <field name="month_day"
                                               invisible="occurs != 'monthly' or monthly_mode != 'day'"/>
                                        <field name="relative_week"
                                               string="The"
                                               invisible="occurs != 'monthly' or monthly_mode != 'relative'"/>
                                        <field name="relative_day"
                                               string="Day"
                                               invisible="occurs != 'monthly' or monthly_mode != 'relative'"/>
                                    </group>
                                    <group invisible="occurs != 'weekly'">
                                        <field name="mon"/>
                                        <field name="tue"/>
                                        <field name="wed"/>
                                        <field name="thu"/>
                                        <field name="fri"/>
                                        <field name="sat"/>
                                        <field name="sun"/>
                                    </group>
                                </group>
                                <group string="Daily frequency">
                                    <group>
                                        <field name="subday_type"
                                               widget="radio"/>
                                        <field name="subday_interval"
                                               invisible="subday_type == 'once'"/>
                                    </group>
                                    <group>
                                        <field name="start_time"
                                               string="Starting at"
                                               widget="float_time"/>
                                        <field name="end_time"
                                               string="Ending at"
                                               widget="float_time"
                                               invisible="subday_type == 'once'"/>
                                    </group>
                                </group>
                                <group string="Duration">
                                    <group>
                                        <field name="start_date"/>
                                    </group>
                                    <group>
                                        <field name="end_date"
                                               placeholder="No end date"/>
                                    </group>
                                </group>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_raes_dw_agent_job_list" model="ir.ui.view">
        <field name="name">raes.dw.agent.job.list</field>
        <field name="model">raes.dw.agent.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="job_name"/>
                <field name="connection_id"/>
                <field name="schedule_name"/>
                <field name="occurs"/>
                <field name="schedule_enabled"/>
                <field name="job_exists"/>
                <field name="last_run_outcome"/>
            </list>
        </field>
    </record>

    <record id="action_raes_dw_agent_job" model="ir.actions.act_window">
        <field name="name">SQL Agent Jobs</field>
        <field name="res_model">raes.dw.agent.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_raes_dw_agent_job"
              name="SQL Agent Jobs"
              parent="menu_dw_connector"
              action="action_raes_dw_agent_job"
              groups="base.group_system"
              sequence="61"/>
</odoo>

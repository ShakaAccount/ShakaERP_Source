<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Inject the Shaka theme into web.layout <head>:
            A one-line inline script that sets `data-theme="glass"` before paint,
            so the SCSS gates (html[data-theme='glass'] …) always fire.

            The visual palette is hard-locked in design_tokens.scss.  Per-Company
            color overrides are no longer emitted; the previous `<style>` block
            reading res.company.shaka_*_color fields was removed when the theme
            switched from the user-configurable glass palette to the locked
            dark palette (#0F1420 / #171D2E / #5B8DEF).
        -->
        <template id="shaka_layout_assets" name="Shaka Theme Layout" inherit_id="web.layout">
            <xpath expr="//head" position="inside">
                <script type="text/javascript">
                    // Set the theme attribute before paint so the gated SCSS
                    // rules always win.  Single theme — no toggle.
                    document.documentElement.setAttribute('data-theme', 'glass');
                </script>
            </xpath>
        </template>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Switch Item in User Menu (Systray) -->
    <template id="shaka_ui_makeover.ThemeSwitchItem" name="Shaka Theme Switch Item">
        <div class="o_theme_switch_item d-flex align-items-center px-2">
            <span class="me-2 small text-muted" style="min-width: 70px;">Theme</span>
            <button class="o_theme_switch_button btn btn-sm d-flex align-items-center gap-2 p-1 rounded-pill"
                    type="button" role="switch" aria-checked="true" aria-label="Switch theme">
                <input type="checkbox" class="form-check-input m-0" role="switch" checked="checked" style="width: 36px; height: 20px;"/>
                <span class="small fw-medium">Glass</span>
            </button>
        </div>
    </template>

    <!-- Inject the theme switch into the user menu dropdown -->
    <template id="shaka_ui_makeover.user_menu_theme_switch" inherit_id="web.UserMenu">
        <xpath expr="//div[hasclass('o_user_menu')]//div[hasclass('dropdown-menu')]" position="inside">
            <div class="dropdown-divider" role="separator"/>
            <t t-call="shaka_ui_makeover.ThemeSwitchItem"/>
        </xpath>
    </template>
</odoo>
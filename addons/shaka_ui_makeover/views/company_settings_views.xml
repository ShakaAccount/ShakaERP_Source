<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- JSON-driven Shaka theme palette settings -->
        <record id="res_config_settings_view_form_shaka_ui" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.shaka_ui_makeover</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="5"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                    <app data-string="تنظیمات پوسته" string="تنظیمات پوسته" name="shaka_theme_palette">
                        <block title="پالت رنگ تم" name="shaka_theme_palette_settings">
                            <setting string="پالت رنگ روشن و تیره" help="رنگ‌های هر دو تم را در قالب JSON وارد کنید. هر رنگ باید HEX باشد؛ مثل #16A34A.">
                                <div class="content-group">
                                    <field name="shaka_theme_palette" widget="text" nolabel="1" class="o_shaka_theme_palette_json"/>
                                    <p class="text-muted mt-2">کلیدهای مجاز: bg، surface، elevated، border، input، hover، text، muted، primary، primary_dark، on_primary، link، pill_bg، pill_text، success، warning، danger</p>
                                </div>
                            </setting>
                            <setting string="اعمال تغییرات" help="پس از ذخیره، صفحه دوباره بارگذاری می‌شود و رنگ‌ها اعمال می‌شوند.">
                                <div class="content-group">
                                    <button type="object" name="action_shaka_apply_theme_colors" string="ذخیره و بارگذاری مجدد" class="btn-primary" icon="fa-refresh"/>
                                    <button type="object" name="action_shaka_reset_theme_palette" string="بازگردانی پالت پیش‌فرض" class="btn-secondary ms-2" icon="fa-undo"/>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
